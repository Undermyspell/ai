{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "includePaths": [
    "zumba-bot/**"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update n8n Docker image tag in base Helm values",
      "managerFilePatterns": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml"
      ],
      "matchStrings": [
        "n8n:\\s*\\n\\s*image:\\s*\\n\\s*repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "n8n-io/n8n",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^n8n@(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update n8n Docker image tag in staging environment",
      "managerFilePatterns": [
        "zumba-bot/deployment/environments/staging/values.yaml"
      ],
      "matchStrings": [
        "n8n:\\s*\\n\\s*image:\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "n8n-io/n8n",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^n8n@(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update postgres Docker image tag in base Helm values",
      "managerFilePatterns": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml"
      ],
      "matchStrings": [
        "postgres:\\s*\\n\\s*image:\\s*\\n\\s*repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Evolution API Docker image tag in base Helm values",
      "managerFilePatterns": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml"
      ],
      "matchStrings": [
        "evolutionApi:\\s*\\n\\s*image:\\s*\\n\\s*repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update ArgoCD version in kustomization.yaml",
      "managerFilePatterns": [
        "zumba-bot/deployment/argocd/base/kustomization.yaml"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Go module dependencies are managed manually, not by Renovate",
      "matchManagers": [
        "gomod"
      ],
      "enabled": false
    },
    {
      "description": "Auto-merge n8n updates in staging environment only",
      "matchFileNames": [
        "zumba-bot/deployment/environments/staging/values.yaml"
      ],
      "matchPackageNames": [
        "n8n-io/n8n"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": [
        "dependencies",
        "staging",
        "n8n",
        "automerge"
      ]
    },
    {
      "description": "Manual review required for base and production values",
      "matchFileNames": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml",
        "zumba-bot/deployment/environments/production/values.yaml"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "manual-review"
      ]
    },
    {
      "description": "Group all postgres updates together",
      "matchPackageNames": [
        "postgres"
      ],
      "groupName": "postgres",
      "automerge": false,
      "labels": [
        "dependencies",
        "postgres",
        "manual-review"
      ]
    },
    {
      "description": "Group all Evolution API updates together",
      "matchPackageNames": [
        "evoapicloud/evolution-api"
      ],
      "groupName": "evolution-api",
      "automerge": false,
      "labels": [
        "dependencies",
        "evolution-api",
        "manual-review"
      ]
    },
    {
      "description": "Separate major updates for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update",
        "manual-review"
      ]
    },
    {
      "description": "ArgoCD updates require manual review",
      "matchPackageNames": [
        "argoproj/argo-cd"
      ],
      "groupName": "argocd",
      "automerge": false,
      "labels": [
        "dependencies",
        "argocd",
        "infrastructure",
        "manual-review"
      ]
    }
  ]
}
