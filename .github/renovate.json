{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "includePaths": [
    "zumba-bot/**"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update postgres Docker image tag in base Helm values",
      "managerFilePatterns": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml"
      ],
      "matchStrings": [
        "postgres:\\s*\\n\\s*image:\\s*\\n\\s*repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Evolution API Docker image tag in base Helm values",
      "managerFilePatterns": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml"
      ],
      "matchStrings": [
        "evolutionApi:\\s*\\n\\s*image:\\s*\\n\\s*repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update ArgoCD version in kustomization.yaml",
      "managerFilePatterns": [
        "zumba-bot/deployment/argocd/base/kustomization.yaml"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update k3s version in system-upgrade plan",
      "managerFilePatterns": [
        "zumba-bot/deployment/system-upgrade/k3s-server-plan.yaml"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v[\\d.]+\\+k3s\\d+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update system-upgrade-controller version in kustomization.yaml",
      "managerFilePatterns": [
        "zumba-bot/deployment/system-upgrade/kustomization.yaml"
      ],
      "matchStrings": [
        "https://github\\.com/rancher/system-upgrade-controller/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "rancher/system-upgrade-controller",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Go module dependencies are managed manually, not by Renovate",
      "matchManagers": [
        "gomod"
      ],
      "enabled": false
    },
    {
      "description": "n8n ist abgeschaltet (Workflow durch whatsapp-bot ersetzt) - keine Updates mehr, auch nicht fuer das Image in docker-compose.yml",
      "matchPackageNames": [
        "docker.n8n.io/n8nio/n8n",
        "n8n-io/n8n"
      ],
      "enabled": false
    },
    {
      "description": "Manual review required for base and production values",
      "matchFileNames": [
        "zumba-bot/deployment/helm-charts/zumba/values.yaml",
        "zumba-bot/deployment/environments/production/values.yaml"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "manual-review"
      ]
    },
    {
      "description": "Group all postgres updates together",
      "matchPackageNames": [
        "postgres"
      ],
      "groupName": "postgres",
      "automerge": false,
      "labels": [
        "dependencies",
        "postgres",
        "manual-review"
      ]
    },
    {
      "description": "Group all Evolution API updates together",
      "matchPackageNames": [
        "evoapicloud/evolution-api"
      ],
      "groupName": "evolution-api",
      "automerge": false,
      "labels": [
        "dependencies",
        "evolution-api",
        "manual-review"
      ]
    },
    {
      "description": "Separate major updates for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update",
        "manual-review"
      ]
    },
    {
      "description": "ArgoCD updates require manual review",
      "matchPackageNames": [
        "argoproj/argo-cd"
      ],
      "groupName": "argocd",
      "automerge": false,
      "labels": [
        "dependencies",
        "argocd",
        "infrastructure",
        "manual-review"
      ]
    },
    {
      "description": "k3s updates: manual review, one minor per step (merge triggers the node upgrade!)",
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "groupName": "k3s",
      "automerge": false,
      "separateMinorPatch": true,
      "separateMultipleMinor": true,
      "labels": [
        "dependencies",
        "k3s",
        "infrastructure",
        "manual-review"
      ]
    },
    {
      "description": "system-upgrade-controller updates require manual review",
      "matchPackageNames": [
        "rancher/system-upgrade-controller"
      ],
      "groupName": "system-upgrade-controller",
      "automerge": false,
      "labels": [
        "dependencies",
        "infrastructure",
        "manual-review"
      ]
    }
  ]
}
