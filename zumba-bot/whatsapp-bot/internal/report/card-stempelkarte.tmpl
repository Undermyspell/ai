<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<style>
  @font-face {
    font-family: "Caveat";
    src: url("{{.Fonts.Caveat}}") format("woff2");
    font-weight: 700;
  }
  @font-face {
    font-family: "Anton";
    src: url("{{.Fonts.Anton}}") format("woff2");
    font-weight: 400;
  }
  :root {
    /* Das Emblem steckt einmal als CSS-Variable in der Datei und wird von
       jedem Stempelfeld referenziert — sonst stünde die Data-URL hunderte
       Male im HTML und das PNG-Rendern würde unnötig teuer. */
    --logo: url("{{.Logo}}");
    --karton: #e3d2b0;
    --karton-tief: #d3bf98;
    --tinte: #33261a;
    --matt: rgba(51, 38, 26, 0.58);
    --schwach: rgba(51, 38, 26, 0.32);
    --linie: rgba(51, 38, 26, 0.18);
    --rot: #a83c2c;
    --gruen: #4f6b3a;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 720px;
    background: #6f5636;
    color: var(--tinte);
    font-family: "Noto Sans", sans-serif;
    font-feature-settings: "tnum";
  }

  /* Die Karte selbst: Karton mit Perforationsrand und Stanzecken. */
  .karte {
    position: relative;
    margin: 16px;
    padding: 30px 34px 26px;
    border-radius: 10px;
    background:
      radial-gradient(circle at 84% 8%, rgba(120, 80, 30, 0.09) 0 20%, transparent 21%),
      repeating-linear-gradient(52deg, rgba(255,255,255,0.05) 0 3px, transparent 3px 16px),
      linear-gradient(158deg, var(--karton), var(--karton-tief));
    box-shadow: 0 2px 0 rgba(120, 90, 40, 0.4), 0 16px 28px rgba(40, 26, 8, 0.4);
  }
  /* Perforationslinie wie bei einer abtrennbaren Treuekarte. */
  .perfo {
    position: absolute; inset: 11px;
    border: 2px dashed var(--schwach);
    border-radius: 6px;
    pointer-events: none;
  }

  .weekly {
    display: inline-block;
    font-family: "Caveat", cursive;
    font-size: 21px;
    color: var(--rot);
    border-bottom: 2px solid rgba(168, 60, 44, 0.4);
    margin-bottom: 14px;
  }

  header { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .haus-block { display: flex; align-items: center; gap: 17px; min-width: 0; }
  /* Der Wirt stempelt mit demselben Emblem, das in jedem Feld klebt. */
  .wirtsstempel {
    flex-shrink: 0;
    width: 82px; height: 82px;
    border-radius: 50%;
    mix-blend-mode: multiply;
    box-shadow: 0 0 0 3px rgba(168, 60, 44, 0.3);
  }
  .haus {
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.34em; text-transform: uppercase;
    color: var(--matt);
  }
  h1 {
    font-family: "Anton", sans-serif;
    font-size: 44px; font-weight: 400; line-height: 1.02;
    letter-spacing: 0.02em;
    margin-top: 5px;
  }
  .unter { font-family: "Caveat", cursive; font-size: 22px; color: var(--matt); margin-top: 1px; }
  .konto { text-align: right; flex-shrink: 0; }
  .konto .zahl { font-family: "Anton", sans-serif; font-size: 40px; line-height: 1; }
  .konto .wort {
    font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--matt); margin-top: 3px;
  }

  .notizen {
    display: flex; gap: 22px;
    margin: 18px 0 12px;
    padding: 12px 0;
    border-top: 1px solid var(--linie);
    border-bottom: 1px solid var(--linie);
    font-family: "Caveat", cursive; font-size: 22px; line-height: 1.15;
  }
  .notiz { flex: 1; min-width: 0; }
  .notiz .was {
    display: block;
    font-family: "Noto Sans", sans-serif;
    font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--matt); margin-bottom: 1px;
  }
  .notiz b { color: var(--rot); }

  /* Legende: erklärt gestempelt vs. leer genau einmal. */
  .legende {
    display: flex; align-items: center; gap: 20px;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--matt);
    margin-bottom: 10px;
  }
  .legende span { display: inline-flex; align-items: center; gap: 7px; }

  /* Ein Block je Gast: Kopfzeile mit Namen und Quote, darunter die
     Stempelreihe — ein Feld je Stammtisch. */
  .gast { padding: 9px 0; border-bottom: 1px dashed var(--linie); }
  .gast:last-child { border-bottom: none; }
  .kopfzeile { display: flex; align-items: baseline; gap: 10px; margin-bottom: 7px; }
  .platz {
    font-family: "Anton", sans-serif; font-size: 16px;
    color: var(--matt); min-width: 22px;
  }
  .gast.spitze .platz { color: var(--rot); }
  /* Caveat ragt nach rechts über die Textbox – ohne die Reserve wird der
     letzte Buchstabe abgeschnitten. */
  .nm {
    flex: none;
    font-family: "Caveat", cursive; font-size: 28px; line-height: 1;
    padding-right: 6px;
    white-space: nowrap;
  }
  .lauf {
    font-size: 10px; font-weight: 700; letter-spacing: 0.04em;
    padding: 2px 6px 3px;
    border: 1.5px solid var(--gruen);
    border-radius: 3px;
    color: var(--gruen);
    transform: rotate(-1.5deg);
    white-space: nowrap;
  }
  .lauf.pause { border-color: var(--rot); color: var(--rot); border-style: dashed; }
  .bilanz {
    margin-left: auto;
    font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase;
    white-space: nowrap;
  }
  .bilanz .ja { color: var(--gruen); }
  .bilanz .nein { color: var(--rot); }
  .bilanz .quote {
    font-family: "Anton", sans-serif;
    font-size: 19px; letter-spacing: 0;
    margin-left: 10px;
    color: var(--tinte);
  }
  .gast.spitze .bilanz .quote { color: var(--rot); }

  .felder { display: flex; flex-wrap: wrap; gap: 5px; }
  /* Gestempelt = besucht. Die Stempel sitzen leicht schief, wie von Hand. */
  .feld {
    width: 22px; height: 22px;
    border-radius: 50%;
    flex: none;
  }
  .feld.voll {
    background-image: var(--logo);
    background-size: cover;
    mix-blend-mode: multiply;
    opacity: 0.95;
  }
  .feld.voll:nth-child(2n) { transform: rotate(5deg); }
  .feld.voll:nth-child(3n) { transform: rotate(-6deg); }
  .feld.voll:nth-child(5n) { transform: rotate(3deg); }
  /* Leeres Feld = gefehlt: gestanzter Kreis, klar als Lücke lesbar. */
  .feld.leer {
    border: 1.5px dashed rgba(168, 60, 44, 0.55);
    background: rgba(168, 60, 44, 0.07);
    position: relative;
  }
  .feld.leer::before, .feld.leer::after {
    content: "";
    position: absolute; left: calc(50% - 0.75px); top: 22%;
    width: 1.5px; height: 56%;
    background: rgba(168, 60, 44, 0.7);
  }
  .feld.leer::before { transform: rotate(42deg); }
  .feld.leer::after { transform: rotate(-42deg); }

  .rechnung { margin-top: 16px; border-top: 2px solid var(--linie); padding-top: 10px; }
  .rechnung .kopf {
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--rot); margin-bottom: 4px;
  }
  .posten { display: flex; align-items: baseline; gap: 10px; font-family: "Caveat", cursive; font-size: 22px; padding: 2px 0; }
  .posten .grund { font-family: "Noto Sans", sans-serif; font-size: 11.5px; color: var(--matt); flex: 1; }
  .posten .betrag { font-family: "Anton", sans-serif; font-size: 19px; color: var(--rot); }
  .posten.bezahlt { opacity: 0.45; text-decoration: line-through; text-decoration-color: var(--schwach); }
  .posten.bezahlt .betrag { color: var(--matt); }
  .sauber { font-family: "Caveat", cursive; font-size: 23px; color: var(--matt); }

  .leer-karte { font-family: "Caveat", cursive; font-size: 26px; padding: 32px 0; color: var(--matt); }

  footer {
    margin-top: 16px;
    display: flex; justify-content: space-between;
    font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--schwach);
  }
</style>
</head>
<body>
<div class="karte">
  <div class="perfo"></div>

  {{if .WeeklyNote}}<div class="weekly">Wochenabrechnung, Donnerstag 21 Uhr</div>{{end}}

  <header>
    <div class="haus-block">
      <img class="wirtsstempel" src="{{.Logo}}" alt="Stammtisch Zumba">
      <div>
        <div class="haus">Stammtisch Zumba</div>
        <h1>TREUEKARTE</h1>
        <div class="unter">Jeder Stammtisch ein Stempel</div>
      </div>
    </div>
    {{if .Users}}
    <div class="konto">
      <div class="zahl">{{.Total}}</div>
      <div class="wort">Felder</div>
    </div>
    {{end}}
  </header>

  {{if .Users}}
  <div class="notizen">
    <div class="notiz"><span class="was">Volleste Karte</span>{{.GoatName}}, <b>{{.GoatPercent}}%</b></div>
    {{if .MaxStreak}}<div class="notiz"><span class="was">Längste Serie</span>{{.MaxStreakNames}}, <b>{{.MaxStreak}}x</b></div>{{end}}
    {{if .MinStreak}}<div class="notiz"><span class="was">Längste Pause</span>{{.MinStreakNames}}, <b>{{.MinStreak}}x</b></div>{{end}}
  </div>

  <div class="legende">
    <span><i class="feld voll" style="width:16px;height:16px"></i> gestempelt = da</span>
    <span><i class="feld leer" style="width:16px;height:16px"></i> leer = gefehlt</span>
  </div>

  {{range .Users}}
  <div class="gast{{if .Top3}} spitze{{end}}">
    <div class="kopfzeile">
      <span class="platz">{{.Rank}}</span>
      <span class="nm">{{.Name}}</span>
      {{if gt .Streak 0}}<span class="lauf">▲ {{.StreakAbs}} in Folge</span>{{end}}
      {{if lt .Streak 0}}<span class="lauf pause">▼ {{.StreakAbs}} verpasst</span>{{end}}
      <span class="bilanz">
        <span class="ja">{{.Attendance}} da</span> · <span class="nein">{{.Away}} gefehlt</span>
        <span class="quote">{{.Percent}}%</span>
      </span>
    </div>
    <div class="felder">
      {{range .Lit}}<span class="feld voll"></span>{{end}}
      {{range .Dark}}<span class="feld leer"></span>{{end}}
    </div>
  </div>
  {{end}}
  {{else}}
  <div class="leer-karte">Noch kein Feld gestempelt.</div>
  {{end}}

  <div class="rechnung">
    <div class="kopf">Offene Rechnung</div>
    {{if .Strafen}}
      {{range .Strafen}}
      <div class="posten{{if .Beglichen}} bezahlt{{end}}">
        <span>{{.Name}}</span>
        <span class="grund">{{.Grund}}{{if .Beglichen}} · bezahlt{{end}}</span>
        <span class="betrag">{{.Betrag}} €</span>
      </div>
      {{end}}
    {{else}}
      <div class="sauber">Alles bezahlt. Prost!</div>
    {{end}}
  </div>

  <footer>
    <span>Zumba-Bot · gestempelt wird automatisch</span>
    <span>{{.Datum}}</span>
  </footer>
</div>
</body>
</html>
