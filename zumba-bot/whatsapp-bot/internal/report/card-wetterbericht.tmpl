<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<style>
  @font-face {
    font-family: "Anton";
    src: url("{{.Fonts.Anton}}") format("woff2");
    font-weight: 400;
  }
  {{range .Fonts.Barlow}}
  @font-face {
    font-family: "Barlow Condensed";
    src: url("{{.URL}}") format("woff2");
    font-weight: {{.Weight}};
  }
  {{end}}
  {{range .Fonts.SpaceMono}}
  @font-face {
    font-family: "Space Mono";
    src: url("{{.URL}}") format("woff2");
    font-weight: {{.Weight}};
  }
  {{end}}
  :root {
    --nacht: #0b2a4a;
    --himmelblau: #9fd0ff;
    --hell: #cfe6ff;
    --sonne: #ffd23f;
    --glas: rgba(255,255,255,.1);
    --glas-rand: rgba(255,255,255,.2);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 720px;
    background: var(--nacht);
    color: #fff;
    font-family: "Barlow Condensed", "Noto Sans", "DejaVu Sans", sans-serif, "Noto Color Emoji";
  }
  .anton { font-family: "Anton", sans-serif; font-weight: 400; }
  /* Himmel von Nacht oben bis Tageslicht unten. */
  .himmel {
    padding: 34px 36px 26px;
    background: linear-gradient(180deg, var(--nacht) 0%, #1b4f7f 55%, #4b8fc4 100%);
  }
  .klein { letter-spacing: .2em; text-transform: uppercase; color: var(--himmelblau); }

  header { display: flex; align-items: flex-end; gap: 16px; }
  .emblem {
    flex-shrink: 0;
    width: 64px; height: 64px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(255,255,255,.35);
  }
  .titel { flex: 1; min-width: 0; }
  .titel .klein { font-size: 14px; letter-spacing: .25em; }
  h1 { font-size: 46px; line-height: 1; letter-spacing: .02em; }
  .messtage {
    flex-shrink: 0;
    background: var(--sonne);
    color: var(--nacht);
    padding: 8px 14px;
    border-radius: 6px;
    text-align: center;
    transform: rotate(3deg);
  }
  .messtage .was { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; }
  .messtage .zahl { font-size: 30px; line-height: 1; }
  .weekly { margin-top: 10px; font-size: 14px; letter-spacing: .14em; }

  .lage { margin-top: 22px; display: flex; gap: 12px; }
  .glas {
    flex: 1; min-width: 0;
    background: var(--glas);
    border: 1px solid var(--glas-rand);
    border-radius: 10px;
    padding: 12px 14px;
  }
  .glas.gross { flex: 1.2; }
  .glas .klein { font-size: 12px; }
  .glas .text { font-size: 20px; font-weight: 700; line-height: 1.2; margin-top: 4px; }
  .glas .wer { font-size: 26px; font-weight: 800; line-height: 1.1; margin-top: 4px; }
  .glas .unter { font-size: 14px; color: var(--hell); }

  /* Eine Wetterkachel je Mitglied: Symbol nach Serie, Quote als Temperatur. */
  .kacheln { margin-top: 18px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .kachel {
    position: relative;
    min-width: 0;
    background: var(--glas);
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 12px;
    padding: 10px 8px 8px;
    text-align: center;
  }
  /* Kachelfarbe nach Wetterlage (wetterFuer). */
  .kachel.vulkan { background: rgba(214,48,32,.42); border-color: rgba(255,120,90,.6); }
  .kachel.hitze { background: rgba(255,128,32,.34); border-color: rgba(255,180,110,.55); }
  .kachel.sonne { background: rgba(255,210,63,.24); border-color: rgba(255,225,130,.5); }
  .kachel.regenbogen {
    background: linear-gradient(160deg,
      rgba(255,96,96,.28), rgba(255,210,63,.24) 30%, rgba(110,210,120,.24) 60%, rgba(90,150,255,.3));
  }
  .kachel.regen { background: rgba(22,40,66,.42); border-color: rgba(160,190,225,.3); }
  .kachel.gewitter { background: rgba(38,30,70,.55); border-color: rgba(190,160,255,.35); }
  .kachel.schnee { background: rgba(215,232,255,.22); border-color: rgba(230,242,255,.55); }
  .kachel.frost { background: rgba(130,205,255,.3); border-color: rgba(205,238,255,.75); }
  /* Die Top 3 tragen einen Goldrahmen – die Farbe gehört dem Wetter. */
  .kachel.top { box-shadow: inset 0 0 0 2px var(--sonne); border-color: var(--sonne); }
  .kachel.top .platz { color: var(--nacht); background: var(--sonne); border-radius: 4px; padding: 0 4px; font-weight: 700; }
  .kachel .platz {
    position: absolute; top: 6px; left: 8px;
    font-family: "Space Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    color: var(--hell);
  }
  .kachel .symbol { font-size: 40px; line-height: 1.1; margin-top: 8px; }
  .kachel .nm {
    font-size: 20px; font-weight: 700; letter-spacing: .02em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .kachel .nm.lang { font-size: 16px; letter-spacing: 0; }
  .kachel .grad { font-size: 28px; line-height: 1; color: var(--himmelblau); }
  .kachel .grad.mild { color: #fff; }
  .kachel .grad.heiss { color: var(--sonne); }
  .kachel .messung { margin-top: 3px; font-size: 14px; font-weight: 600; color: #fff; }
  .kachel .wetter {
    margin-top: 3px;
    font-size: 12px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--hell);
  }
  .kachel .serie { font-size: 13px; font-weight: 700; letter-spacing: .04em; color: #fff; }

  /* Unwetterwarnung in den Warnstufen-Farben des DWD: der Kasten nimmt die
     höchste Stufe der offenen Strafen an, jede Zeile trägt ihr Warndreieck. */
  :root {
    --stufe-1: #ffeb3b;
    --stufe-2: #ff9800;
    --stufe-3: #e53935;
    --stufe-4: #b03cc8;
  }
  .warnung {
    margin-top: 18px;
    background: var(--glas);
    border: 1px solid var(--glas-rand);
    border-left-width: 8px;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .warnung.stufe-1 { background: rgba(255,235,59,.16); border-color: var(--stufe-1); }
  .warnung.stufe-2 { background: rgba(255,152,0,.24); border-color: var(--stufe-2); }
  .warnung.stufe-3 { background: rgba(229,57,53,.32); border-color: var(--stufe-3); }
  .warnung.stufe-4 { background: rgba(176,60,200,.36); border-color: var(--stufe-4); }
  .warnung .kopf {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    font-size: 12px; letter-spacing: .25em; text-transform: uppercase; color: #fff;
  }
  .warnung .stufe { font-size: 13px; font-weight: 800; letter-spacing: .12em; white-space: nowrap; }
  .warnung.stufe-1 .stufe { color: var(--stufe-1); }
  .warnung.stufe-2 .stufe { color: var(--stufe-2); }
  .warnung.stufe-3 .stufe { color: #ff8a80; }
  .warnung.stufe-4 .stufe { color: #e7a6f5; }
  /* Warndreieck mit Ausrufezeichen, gefüllt in der Farbe der Stufe. */
  .dreieck {
    flex-shrink: 0;
    align-self: center;
    display: inline-flex; align-items: flex-end; justify-content: center;
    width: 24px; height: 21px;
    padding-bottom: 1px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    font-size: 13px; font-weight: 800; line-height: 1;
    color: #1a1a1a;
    background: var(--stufe-1);
  }
  .dreieck.stufe-2 { background: var(--stufe-2); }
  .dreieck.stufe-3 { background: var(--stufe-3); color: #fff; }
  .dreieck.stufe-4 { background: var(--stufe-4); color: #fff; }
  .strafe.beglichen .dreieck { background: rgba(255,255,255,.5); color: #1a1a1a; }
  /* Ohne Strafen gibt es keine Warnung – dann nur ein ruhiger Glaskasten. */
  .warnung.ruhig { background: var(--glas); border-color: var(--glas-rand); }
  .warnung.ruhig .kopf { color: var(--himmelblau); }
  .strafe {
    display: flex; gap: 10px; align-items: baseline;
    padding: 5px 0;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }
  .strafe.beglichen { opacity: .5; }
  .strafe .nm { font-size: 20px; font-weight: 700; }
  .strafe .grund { flex: 1; font-size: 14px; color: #ffe3e3; }
  .strafe .betrag { font-size: 20px; }
  .sauber { font-size: 20px; font-weight: 700; margin-top: 4px; }

  .leer { margin-top: 26px; font-size: 24px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--hell); }

  footer {
    margin-top: 16px;
    display: flex; justify-content: space-between;
    font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--himmelblau);
    align-items: center;
  }
  /* Der Zumba-Bot als Signet neben der Bot-Zeile. */
  .absender { display: inline-flex; align-items: center; gap: 8px; }
  .bot {
    width: 42px; height: 32px; flex-shrink: 0;
    border-radius: 6px; object-fit: cover;
    box-shadow: 0 0 0 2px rgba(255,255,255,.35);
  }
</style>
</head>
<body>
<div class="himmel">
  <header>
    <img class="emblem" src="{{.Logo}}" alt="Stammtisch Zumba">
    <div class="titel">
      <div class="klein">Das Stammtisch-Wetter · {{.Datum}}</div>
      <h1 class="anton">ZUMBA WETTERBERICHT</h1>
    </div>
    <div class="messtage">
      <div class="was">Messtage</div>
      <div class="zahl anton">{{.Total}}</div>
    </div>
  </header>
  {{if .WeeklyNote}}<div class="weekly klein">● Live aus dem Wetterstudio · Donnerstag 21:00</div>{{end}}

  {{if .Users}}
  <div class="lage">
    <div class="glas gross">
      <div class="klein">Großwetterlage</div>
      <div class="text">Stabiles Hoch „{{.GoatName}}“ über dem Stammtisch, {{.GoatQuote}} % Sonnenanteil. Ø {{.AvgPercent}} % im Saisonmittel.</div>
    </div>
    {{if .MaxStreak}}
    <div class="glas">
      <div class="klein">🔥 Hitzewelle</div>
      <div class="wer">{{.MaxStreakNames}}</div>
      <div class="unter">{{.MaxStreak}} {{if eq .MaxStreak 1}}Donnerstag{{else}}Donnerstage{{end}} am Stück</div>
    </div>
    {{end}}
    {{if .MinStreak}}
    <div class="glas">
      <div class="klein">🧊 Kältefront</div>
      <div class="wer">{{.MinStreakNames}}</div>
      <div class="unter">seit {{.MinStreak}} {{if eq .MinStreak 1}}Woche{{else}}Wochen{{end}} nicht gesehen</div>
    </div>
    {{end}}
  </div>

  <div class="kacheln">
    {{range .Users}}
    <div class="kachel {{.Wetter.Art}}{{if .Top3}} top{{end}}">
      <span class="platz">{{.Rank}}</span>
      <div class="symbol">{{.Wetter.Symbol}}</div>
      <div class="nm{{if .NameLang}} lang{{end}}">{{.Name}}</div>
      <div class="grad anton{{if ge .Quote 85}} heiss{{else if ge .Quote 60}} mild{{end}}">{{.Quote}}°</div>
      <div class="messung">{{.Attendance}} da · {{.Away}} weg</div>
      <div class="wetter">{{.Wetter.Text}}</div>
      <div class="serie">{{if gt .Streak 0}}Serie +{{.StreakAbs}}{{else if lt .Streak 0}}Pause −{{.StreakAbs}}{{else}}keine Serie{{end}}</div>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="leer">Keine Messwerte · Keine Daten</div>
  {{end}}

  {{if .Strafen}}
  <div class="warnung{{if .Warnstufe}} stufe-{{.Warnstufe}}{{end}}">
    <div class="kopf">
      <span>⚠ Amtliche Unwetterwarnung · Strafen</span>
      <span class="stufe">{{if eq .Warnstufe 4}}Stufe 4 · Extremes Unwetter{{else if eq .Warnstufe 3}}Stufe 3 · Unwetter{{else if eq .Warnstufe 2}}Stufe 2 · Markantes Wetter{{else if eq .Warnstufe 1}}Stufe 1 · Wetterwarnung{{else}}Warnungen aufgehoben{{end}}</span>
    </div>
    {{range .Strafen}}
    <div class="strafe{{if .Beglichen}} beglichen{{end}}">
      <span class="dreieck stufe-{{.Warnstufe}}">!</span>
      <span class="nm">{{.Name}}</span>
      <span class="grund">{{.Grund}}{{if .Beglichen}} · beglichen{{end}}</span>
      <span class="betrag anton">{{.Betrag}} €</span>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="warnung ruhig">
    <div class="kopf">Keine Unwetterwarnungen</div>
    <div class="sauber">Keine offenen Strafen ☀️</div>
  </div>
  {{end}}

  <footer>
    <span class="absender"><img class="bot" src="{{.Bot}}" alt="Zumba-Bot">Ihr Wetterfrosch: Zumba-Bot</span>
    <span>Vorhersage für Donnerstag: 🍻 100 %</span>
  </footer>
</div>
</body>
</html>
