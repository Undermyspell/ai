package templates

// SlideNavigation steuert die Story: eine Slide zur Zeit, Fortschritt oben in
// Segmenten, Tippen rechts = weiter, links = zurück, Halten = Pause.
templ SlideNavigation() {
	<script>
		// Stammtisch Wrapped – Story-Navigation
		// =====================================
		class StammtischWrapped {
			constructor() {
				this.currentSlide = 0;
				this.slides = [];
				this.progressInterval = null;
				this.elapsed = 0;
				this.isPaused = false;
				this.slideDuration = 5000;
				this.holdTimer = null;
				this.isHolding = false;
				this.suppressClick = false;
				this.init();
			}

			init() {
				this.slides = document.querySelectorAll(".slide");
				this.totalSlides = this.slides.length;
				this.buildSegments();
				this.setupEventListeners();
				this.showSlide(0);
				this.startAutoNavigation();
			}

			buildSegments() {
				const bar = document.getElementById("story-bar");
				bar.innerHTML = "";
				for (let i = 0; i < this.totalSlides; i++) {
					const seg = document.createElement("span");
					seg.appendChild(document.createElement("i"));
					bar.appendChild(seg);
				}
				this.segments = bar.querySelectorAll("span");
			}

			updateSegments() {
				this.segments.forEach((seg, i) => {
					seg.classList.toggle("done", i < this.currentSlide);
					if (i >= this.currentSlide) seg.firstChild.style.width = "0%";
				});
			}

			setProgress(pct) {
				const seg = this.segments[this.currentSlide];
				if (seg) seg.firstChild.style.width = `${Math.min(pct, 100)}%`;
			}

			isControl(target) {
				return target.closest("button, a, .top-actions");
			}

			setupEventListeners() {
				// Tippen: linkes Drittel zurück, sonst weiter (wie Instagram)
				document.addEventListener("click", (e) => {
					if (this.suppressClick) {
						this.suppressClick = false;
						return;
					}
					if (this.isControl(e.target)) return;
					if (e.clientX < window.innerWidth * 0.3) {
						this.prevSlide();
					} else {
						this.nextSlide();
					}
				});

				// Halten pausiert, Loslassen setzt fort; ein Halten ist kein Tippen.
				document.addEventListener("pointerdown", (e) => {
					if (this.isControl(e.target)) return;
					this.holdTimer = setTimeout(() => {
						this.isHolding = true;
						this.pauseProgress();
					}, 200);
				});
				const endHold = () => {
					clearTimeout(this.holdTimer);
					this.holdTimer = null;
					if (this.isHolding) {
						this.isHolding = false;
						this.suppressClick = true;
						setTimeout(() => { this.suppressClick = false; }, 350);
						this.resumeProgress();
					}
				};
				document.addEventListener("pointerup", endHold);
				document.addEventListener("pointercancel", endHold);
				document.addEventListener("contextmenu", (e) => {
					if (this.isHolding) e.preventDefault();
				});

				document.addEventListener("keydown", (e) => {
					switch (e.key) {
						case "ArrowRight":
						case " ":
							e.preventDefault();
							this.nextSlide();
							break;
						case "ArrowLeft":
							this.prevSlide();
							break;
						case "Escape":
							this.togglePause();
							break;
					}
				});

				let touchStartX = 0;
				document.addEventListener("touchstart", (e) => {
					touchStartX = e.changedTouches[0].screenX;
				}, { passive: true });
				document.addEventListener("touchend", (e) => {
					const diff = touchStartX - e.changedTouches[0].screenX;
					if (Math.abs(diff) > 50) {
						this.suppressClick = true;
						setTimeout(() => { this.suppressClick = false; }, 350);
						diff > 0 ? this.nextSlide() : this.prevSlide();
					}
				}, { passive: true });
			}

			showSlide(index) {
				if (index < 0 || index >= this.totalSlides) return;
				this.slides.forEach((slide) => slide.classList.remove("active"));
				this.currentSlide = index;
				const el = this.slides[index];
				el.classList.add("active");
				this.triggerAnimations(el);
				this.updateSegments();
				this.slideDuration = parseInt(el.dataset.duration, 10) || 5000;
			}

			triggerAnimations(slideEl) {
				slideEl.querySelectorAll(".animate-on-enter, .animate-bar").forEach((el) => {
					el.style.animation = "none";
					el.offsetHeight;
					el.style.animation = "";
				});
				slideEl.querySelectorAll(".animate-on-enter").forEach((el) => {
					// Rückfall: sichtbar machen, falls die Animation nie lief
					setTimeout(() => { el.style.opacity = "1"; }, 3500);
				});
				slideEl.querySelectorAll("[data-count-to]").forEach((c) => this.animateCounter(c));
			}

			animateCounter(element) {
				const target = parseInt(element.dataset.countTo, 10);
				const duration = parseInt(element.dataset.countDuration, 10) || 1800;
				const suffix = element.dataset.countSuffix || "";
				const delay = parseInt(element.dataset.countDelay, 10) || 250;
				element.textContent = "0" + suffix;
				const start = performance.now() + delay;
				const tick = (now) => {
					const p = Math.max(0, Math.min((now - start) / duration, 1));
					const eased = 1 - (1 - p) ** 4;
					element.textContent = Math.round(target * eased) + suffix;
					if (p < 1) requestAnimationFrame(tick);
				};
				requestAnimationFrame(tick);
			}

			hideTapHint() {
				const hint = document.getElementById("tap-hint");
				if (hint) hint.style.opacity = "0";
			}

			nextSlide() {
				this.hideTapHint();
				this.resetTimer();
				if (this.currentSlide < this.totalSlides - 1) {
					this.showSlide(this.currentSlide + 1);
					this.startAutoNavigation();
				} else {
					this.setProgress(100);
				}
			}

			prevSlide() {
				this.resetTimer();
				if (this.currentSlide > 0) {
					this.showSlide(this.currentSlide - 1);
				}
				this.startAutoNavigation();
			}

			startAutoNavigation() {
				if (this.isPaused) return;
				this.resetTimer();
				this.runProgress();
			}

			runProgress() {
				this.progressInterval = setInterval(() => {
					this.elapsed += 100;
					this.setProgress((this.elapsed / this.slideDuration) * 100);
					if (this.elapsed >= this.slideDuration) this.nextSlide();
				}, 100);
			}

			pauseProgress() {
				if (this.progressInterval) {
					clearInterval(this.progressInterval);
					this.progressInterval = null;
				}
			}

			resumeProgress() {
				if (!this.progressInterval && !this.isPaused) this.runProgress();
			}

			resetTimer() {
				this.pauseProgress();
				this.elapsed = 0;
				this.setProgress(0);
			}

			togglePause() {
				this.isPaused = !this.isPaused;
				document.body.classList.toggle("is-paused", this.isPaused);
				if (this.isPaused) {
					this.pauseProgress();
				} else {
					this.resumeProgress();
				}
			}
		}

		// Quiz: Antwort zeigen und dem Lesen Zeit geben
		function revealQuizAnswer(btn) {
			const answer = btn.parentElement.querySelector(".quiz-answer");
			if (!answer) return;
			btn.classList.add("hidden");
			answer.classList.remove("hidden");
			answer.classList.add("animate-on-enter", "in-pop");
			if (window.app) window.app.startAutoNavigation();
		}

		// Share-Bild: Eckdaten im aktuellen Theme auf ein Canvas, dann
		// Web Share oder Download.
		async function shareWrapped() {
			const dataEl = document.getElementById("share-data");
			if (!dataEl) return;
			const stats = JSON.parse(dataEl.dataset.share);
			const css = getComputedStyle(document.documentElement);
			const v = (name) => css.getPropertyValue(name).trim();
			const font = '"Plus Jakarta Sans", sans-serif';
			try { await document.fonts.load(`800 120px ${font}`); } catch (e) { /* Systemschrift */ }

			const w = 1080, h = 1350;
			const canvas = document.createElement("canvas");
			canvas.width = w;
			canvas.height = h;
			const ctx = canvas.getContext("2d");

			ctx.fillStyle = v("--bg");
			ctx.fillRect(0, 0, w, h);
			const glow = (x, y, r, color) => {
				const g = ctx.createRadialGradient(x, y, 0, x, y, r);
				g.addColorStop(0, color);
				g.addColorStop(1, "transparent");
				ctx.fillStyle = g;
				ctx.fillRect(0, 0, w, h);
			};
			glow(120, 80, 820, v("--glow-1"));
			glow(w, h, 760, "rgba(255, 181, 71, .28)");

			const pad = 96;
			const logo = new Image();
			logo.src = "/static/img/logo.png";
			try { await logo.decode(); ctx.drawImage(logo, pad, pad, 104, 104); } catch (e) { /* ohne Logo */ }

			ctx.textBaseline = "alphabetic";
			ctx.fillStyle = v("--ink-amber");
			ctx.font = `800 30px ${font}`;
			ctx.fillText("STAMMTISCH WRAPPED", pad, 300);
			ctx.fillStyle = v("--text");
			ctx.font = `800 220px ${font}`;
			ctx.fillText(String(stats.year), pad - 10, 500);

			const rows = [
				[String(stats.thursdays), "Donnerstage"],
				[String(stats.users), "Stammtischler"],
				[stats.avgRate + "%", "Ø Teilnahme"],
				[stats.strafenSum + " €", "Strafenkasse"],
			];
			let y = 640;
			for (const [num, label] of rows) {
				ctx.strokeStyle = v("--line-strong");
				ctx.lineWidth = 2;
				ctx.beginPath(); ctx.moveTo(pad, y - 70); ctx.lineTo(w - pad, y - 70); ctx.stroke();
				ctx.fillStyle = v("--text");
				ctx.font = `800 72px ${font}`;
				ctx.fillText(num, pad, y);
				ctx.fillStyle = v("--muted");
				ctx.font = `600 36px ${font}`;
				ctx.fillText(label, pad + 330, y - 8);
				y += 120;
			}
			ctx.fillStyle = v("--ink-amber");
			ctx.font = `800 40px ${font}`;
			ctx.fillText("👑 " + stats.topUser, pad, y + 20);
			ctx.fillStyle = v("--faint");
			ctx.font = `600 30px ${font}`;
			ctx.fillText("Prost auf euch alle! 🍻", pad, h - pad);

			const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/png"));
			const file = new File([blob], `stammtisch-wrapped-${stats.year}.png`, { type: "image/png" });
			if (navigator.canShare && navigator.canShare({ files: [file] })) {
				try {
					await navigator.share({ files: [file], title: "Stammtisch Wrapped " + stats.year });
					return;
				} catch (e) {
					if (e.name === "AbortError") return;
				}
			}
			const a = document.createElement("a");
			a.href = URL.createObjectURL(blob);
			a.download = file.name;
			a.click();
			URL.revokeObjectURL(a.href);
		}

		document.addEventListener("DOMContentLoaded", () => {
			window.app = new StammtischWrapped();
		});
	</script>
}

// themeScript setzt Hell/Dunkel vor dem ersten Zeichnen (kein Aufblitzen):
// gemerkte Wahl, sonst Systemeinstellung – wie im Admin-Portal.
templ themeScript() {
	<script>
		(function () {
			var KEY = "zumba-wrapped-theme";
			var root = document.documentElement;
			function stored() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
			function effective(s) {
				if (s === "light" || s === "dark") return s;
				return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
			}
			function apply(theme) {
				root.setAttribute("data-theme", theme);
				document.querySelectorAll(".theme-toggle").forEach(function (el) {
					el.textContent = theme === "dark" ? "☾" : "☀";
				});
			}
			apply(effective(stored()));
			document.addEventListener("DOMContentLoaded", function () {
				apply(effective(stored()));
				document.addEventListener("click", function (e) {
					if (!e.target.closest(".theme-toggle")) return;
					var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
					try { localStorage.setItem(KEY, next); } catch (err) { /* privates Fenster */ }
					apply(next);
				});
				window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", function (e) {
					if (!stored()) apply(e.matches ? "light" : "dark");
				});
			});
		})();
	</script>
}

// Layout ist das Grundgerüst aller Jahrgänge.
templ Layout(title string, year string) {
	<!DOCTYPE html>
	<html lang="de" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>{ title }</title>
			@themeScript()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<link rel="icon" href="/static/img/logo.png"/>
		</head>
		<body>
			<div id="story-bar" class="story-bar" aria-hidden="true"></div>
			<div class="story-top">
				<div class="brand">
					<img src="/static/img/logo.png" alt=""/>
					<span>Stammtisch <b>Wrapped { year }</b></span>
				</div>
				<div class="top-actions">
					<span class="pause-flag">PAUSE</span>
					<button class="icon-btn theme-toggle" type="button" title="Hell/Dunkel umschalten" aria-label="Hell/Dunkel umschalten">☾</button>
				</div>
			</div>
			<div id="tap-hint">Tippen zum Weiter · links zurück</div>
			<div id="slides-container">
				{ children... }
			</div>
			@SlideNavigation()
		</body>
	</html>
}
