package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// FullHouse – Donnerstage, an denen alle da waren.
templ FullHouse(fh viewmodels.FullHouseView) {
	<section class="slide" data-tone="green" data-duration="6000">
		if fh.HasAny {
			<div class="scene is-center">
				<p class="eyebrow animate-on-enter in-fade">Volle Hütte</p>
				<p class="display animate-on-enter in-big delay-100 gap-s">
					<span data-count-to={ fmt.Sprintf("%d", fh.Count) }>0</span><small>×</small>
				</p>
				<p class="headline animate-on-enter in-up delay-300 gap-s">saßen <em>alle</em> am Tisch</p>
				<div class="chips gap-m animate-on-enter in-up delay-500">
					for _, d := range fh.Dates {
						<span class="chip is-tone">🍻 { d }</span>
					}
					if fh.More > 0 {
						<span class="chip">{ fmt.Sprintf("+%d weitere", fh.More) }</span>
					}
				</div>
			</div>
		} else {
			<img class="opener-art animate-on-enter delay-200" src="/static/img/emoji/1fa91.svg" alt="" aria-hidden="true"/>
			<div class="scene is-low">
				<p class="eyebrow animate-on-enter in-fade">Volle Hütte</p>
				<h2 class="headline animate-on-enter in-up delay-150 gap-s">Kein einziges Mal waren <em>alle</em> da.</h2>
				<p class="lede animate-on-enter in-fade delay-400 gap-s">2027 holen wir das nach. 🍻</p>
			</div>
		}
	</section>
}

// FunCardView – ein Fundstück der Auswertung.
templ FunCardView(card viewmodels.FunCard) {
	<div class={ "panel is-tinted animate-on-enter in-up", card.DelayClass } data-tone={ card.Tone }>
		<p class="eyebrow">{ card.Emoji } { card.Title }</p>
		<p class="fun-headline">{ card.Headline }</p>
		<p class="fun-detail">{ card.Detail }</p>
		if card.Quote != "" {
			<p class="fun-quote">„{ card.Quote }“</p>
		}
	</div>
}

// FunCards – eine Slide voller Fundstücke.
templ FunCards(emoji string, title string, subtitle string, cards []viewmodels.FunCard) {
	<section class="slide" data-tone="blue" data-duration="8000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">{ emoji } { subtitle }</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">{ title }</h2>
			<div class="list gap-m">
				for _, card := range cards {
					@FunCardView(card)
				}
			</div>
		</div>
	</section>
}

// Quiz – Frage, Trommelwirbel, Auflösung.
templ Quiz(quiz viewmodels.QuizView) {
	<section class="slide" data-tone="amber" data-duration="15000">
		<div class="scene is-center">
			<p class="eyebrow animate-on-enter in-fade">🍀 Stammtisch-Quiz</p>
			<h2 class="headline animate-on-enter in-up delay-150 gap-s">{ quiz.Question }</h2>
			<div class="gap-l">
				<button
					type="button"
					onclick="event.stopPropagation(); revealQuizAnswer(this)"
					class="btn animate-on-enter in-up delay-500"
				>
					Auflösen 🥁
				</button>
				<div class="quiz-answer hidden">
					<div class="item is-tinted">
						<span class="emo" aria-hidden="true">{ quiz.AnswerEmoji }</span>
						<div class="item-body">
							<b class="quiz-name">{ quiz.AnswerName }</b>
							<span>{ quiz.AnswerDetail }</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
