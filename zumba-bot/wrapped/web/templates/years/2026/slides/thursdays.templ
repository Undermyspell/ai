package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// ThursdayCardView – ein Donnerstag mit Belegung.
templ ThursdayCardView(card viewmodels.ThursdayCard, tone string) {
	<div class={ "item is-tinted animate-on-enter in-left", card.DelayClass } data-tone={ tone }>
		<span class="emo" aria-hidden="true">{ card.RankDisplay }</span>
		<div class="item-body">
			<b>{ card.DateDisplay }</b>
			<span>{ fmt.Sprintf("%d von %d am Tisch", card.Attendees, card.Total) }</span>
			<div class={ "meter", card.BarTone }><i class="animate-bar" style={ fmt.Sprintf("--w: %d", card.Rate) }></i></div>
		</div>
		<span class="item-num">{ fmt.Sprintf("%d", card.Attendees) }</span>
	</div>
}

// Thursdays – die vollsten und die leersten Abende.
templ Thursdays(best []viewmodels.ThursdayCard, worst []viewmodels.ThursdayCard) {
	<section class="slide" data-tone="green" data-duration="8000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">03 — Donnerstage</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Legendär und einsam</h2>
			<div class="gap-m">
				<p class="section-label animate-on-enter in-fade delay-150" data-tone="green">🍻 Die vollsten Abende</p>
				<div class="list">
					for _, card := range best {
						@ThursdayCardView(card, "green")
					}
				</div>
				<p class="section-label animate-on-enter in-fade delay-600" data-tone="neutral">🪦 Die einsamsten Abende</p>
				<div class="list">
					for _, card := range worst {
						@ThursdayCardView(card, "neutral")
					}
				</div>
			</div>
		</div>
	</section>
}
