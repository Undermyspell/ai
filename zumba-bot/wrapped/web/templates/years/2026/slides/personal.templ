package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// PersonalityTypeCard – ein Stammtisch-Typ und wer dazugehört.
templ PersonalityTypeCard(pt viewmodels.PersonalityType) {
	<div class={ "panel animate-on-enter in-up", pt.DelayClass }>
		<div class="type-head">
			<span class="emo" aria-hidden="true">{ pt.Emoji }</span>
			<div>
				<b class="type-name">{ pt.Name }</b>
				<span class="type-desc">{ pt.Description }</span>
			</div>
		</div>
		<div class="chips gap-s">
			for _, user := range pt.Users {
				<span class="chip">{ user.Emoji } { user.Name }</span>
			}
			if pt.HasMore {
				<span class="chip">{ fmt.Sprintf("+%d", pt.MoreCount) }</span>
			}
		</div>
	</div>
}

// PersonalityTypes – welcher Typ bist du?
templ PersonalityTypes(types []viewmodels.PersonalityType) {
	<section class="slide" data-tone="blue" data-duration="6000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">🎭 Typen</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Welcher Typ bist du?</h2>
			<div class="list gap-m">
				for _, pt := range types {
					@PersonalityTypeCard(pt)
				}
			</div>
		</div>
	</section>
}
