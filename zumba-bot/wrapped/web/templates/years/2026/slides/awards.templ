package slides

import (
	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// AwardsIntro – Kapitel Awards.
templ AwardsIntro() {
	<section class="slide" data-tone="amber" data-duration="4000">
		<img class="opener-art animate-on-enter delay-200" src="/static/img/emoji/1f3c5.svg" alt="" aria-hidden="true"/>
		<div class="scene is-low">
			<p class="chapter-no animate-on-enter in-fade">05 — Awards</p>
			<h2 class="headline animate-on-enter in-up delay-150 gap-s">Und der Gewinner <em>ist …</em></h2>
		</div>
	</section>
}

// AwardCard – ein Award, wer ihn bekommt und womit. Bei Gleichstand
// stehen alle Gewinner nebeneinander.
templ AwardCard(award viewmodels.AwardView) {
	<div class={ "panel is-tinted award animate-on-enter in-up", award.DelayClass } data-tone={ award.Tone }>
		<span class="emo" aria-hidden="true">{ award.Emoji }</span>
		<div class="award-body">
			<p class="award-title">{ award.Title }</p>
			<p class="award-sub">{ award.Subtitle }</p>
			<p class="award-winners">
				for _, w := range award.Winners {
					<span><span aria-hidden="true">{ w.Emoji }</span> { w.Name }</span>
				}
			</p>
			if award.Detail != "" {
				<p class="award-detail">{ award.Detail }</p>
			}
		</div>
	</div>
}

// Awards – eine Slide mit Preisen (Schmäh- oder Ehrenpreise).
templ Awards(tone string, eyebrow string, title string, awards []viewmodels.AwardView) {
	<section class="slide" data-tone={ tone } data-duration="10000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">{ eyebrow }</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">{ title }</h2>
			<div class="list gap-m">
				for _, award := range awards {
					@AwardCard(award)
				}
			</div>
		</div>
	</section>
}

// ConfettiParticle – ein Konfetti-Schnipsel (serverseitig gewürfelt).
templ ConfettiParticle(p viewmodels.ConfettiParticle) {
	<i
		style={ "left: " + p.Left + "; width: " + p.Size + "; height: " + p.Size + "; background: " + p.Color + "; border-radius: " + p.BorderRadius + "; animation-duration: " + p.Duration + "; animation-delay: " + p.Delay + ";" }
	></i>
}

// Finale – Danke, teilen, Prost.
templ Finale(confetti viewmodels.ConfettiView) {
	<section class="slide" data-tone="blue" data-duration="10000">
		<div class="confetti" aria-hidden="true">
			for _, p := range confetti.Particles {
				@ConfettiParticle(p)
			}
		</div>
		<div class="scene is-low">
			<p class="eyebrow animate-on-enter in-fade">Danke</p>
			<h2 class="headline animate-on-enter in-up delay-200 gap-s">für ein legendäres Stammtisch-Jahr <em>2026</em>.</h2>
			<p class="lede animate-on-enter in-fade delay-500 gap-s">2027 wird noch stärker – donnerstags. 🍻</p>
			<div class="gap-l animate-on-enter in-up delay-800">
				<button type="button" class="btn" onclick="event.stopPropagation(); shareWrapped()">📲 Als Bild teilen</button>
			</div>
			<p class="meta animate-on-enter in-fade delay-1200 gap-m">Prost auf euch alle!</p>
		</div>
	</section>
}
