package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// CategoryCard – eine Ausreden-Kategorie mit Balken.
templ CategoryCard(cat viewmodels.CategoryStat) {
	<div class={ "bar-row animate-on-enter in-left", cat.DelayClass }>
		<div class="bar-row-head">
			<b>{ cat.Emoji } { cat.Label }</b>
			<span class="num">{ fmt.Sprintf("%d×", cat.Count) }</span>
		</div>
		<div class="meter is-thick"><i class="animate-bar" style={ fmt.Sprintf("--w: %d", cat.Percentage) }></i></div>
	</div>
}

// ExcuseCategories – woran es lag.
templ ExcuseCategories(categories []viewmodels.CategoryStat) {
	<section class="slide" data-tone="blue" data-duration="7000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">02 — Ausreden</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Woran es lag</h2>
			<div class="panel gap-m animate-on-enter in-up delay-150">
				for _, cat := range categories {
					@CategoryCard(cat)
				}
			</div>
		</div>
	</section>
}

// ExcuseCard – eine Ausrede im Wortlaut.
templ ExcuseCard(excuse viewmodels.Excuse) {
	<div class={ "quote animate-on-enter in-up", excuse.DelayClass }>
		<p>{ excuse.Message }</p>
		<span class="meta">— { excuse.UserName }</span>
	</div>
}

// RecycledExcuseCard – dieselbe Ausrede, mehrfach verwendet.
templ RecycledExcuseCard(r viewmodels.RecycledExcuse) {
	<div class={ "quote is-short animate-on-enter in-up", r.DelayClass } data-tone="amber">
		<p>{ r.Message }</p>
		<span class="meta">— { r.UserName } · { fmt.Sprintf("%d×", r.Count) } wortgleich</span>
	</div>
}

// BestExcuses – die kreativsten Ausreden und das Recycling.
templ BestExcuses(excuses []viewmodels.Excuse, recycled []viewmodels.RecycledExcuse) {
	<section class="slide" data-tone="blue" data-duration="9000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">Ausreden</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Die kreativsten des Jahres</h2>
			<div class="list gap-m">
				for _, excuse := range excuses {
					@ExcuseCard(excuse)
				}
			</div>
			if len(recycled) > 0 {
				<p class="section-label animate-on-enter in-fade delay-1000 gap-m" data-tone="amber">♻️ Wortgleich recycelt</p>
				<div class="list">
					for _, r := range recycled {
						@RecycledExcuseCard(r)
					}
				</div>
			}
		</div>
	</section>
}

// AttendanceHeatmapCell – ein Monat.
templ AttendanceHeatmapCell(month viewmodels.AttendanceHeatmapMonth) {
	<div class={ "heat-cell animate-on-enter in-pop", month.DelayClass, month.Level }>
		<span class="m">{ month.Label }</span>
		<span class="v">{ fmt.Sprintf("%d%%", month.Rate) }</span>
		<span class="s">{ fmt.Sprintf("%d Absagen", month.Count) }</span>
	</div>
}

// AttendanceHeatmap – das Jahr Monat für Monat.
templ AttendanceHeatmap(months []viewmodels.AttendanceHeatmapMonth, insight viewmodels.AttendanceHeatmapInsight) {
	<section class="slide" data-tone="blue" data-duration="6000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">Kalender</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Das Jahr, Monat für Monat</h2>
			<p class="lede animate-on-enter in-fade delay-150 gap-xs">Anwesenheit je Monat – je kräftiger, desto voller der Tisch.</p>
			<div class="heat gap-m">
				for _, month := range months {
					@AttendanceHeatmapCell(month)
				}
			</div>
			<div class="heat-legend animate-on-enter in-fade delay-700">
				<span>wenig</span><i></i><i class="lv-2"></i><i class="lv-4"></i><span>voll</span>
			</div>
			<div class="gap-m">
				<div class="figure animate-on-enter in-left delay-800">
					<span class="figure-num is-green">{ fmt.Sprintf("%d%%", insight.BestRate) }</span>
					<span class="figure-label">Bester Monat: <b>{ insight.BestMonth }</b></span>
				</div>
				<div class="figure animate-on-enter in-left delay-900">
					<span class="figure-num is-red">{ fmt.Sprintf("%d%%", insight.WorstRate) }</span>
					<span class="figure-label">Schwächster Monat: <b>{ insight.WorstMonth }</b></span>
				</div>
			</div>
		</div>
	</section>
}

// AISummary – das Jahr in einem Absatz.
templ AISummary(stats viewmodels.AIStats) {
	<section class="slide" data-tone="cyan" data-duration="7000">
		<div class="scene is-center">
			<p class="eyebrow animate-on-enter in-fade">Zusammengefasst</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Der typische Stammtisch 2026</h2>
			<p class="summary lede animate-on-enter in-up delay-300 gap-m">
				@templ.Raw(stats.SummaryHTML)
			</p>
			<p class="meta pulse animate-on-enter in-fade delay-700 gap-m">✨ automatisch zusammengefasst</p>
		</div>
	</section>
}
