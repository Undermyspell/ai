package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// StrafenIntro – Kapitel Strafenkasse.
templ StrafenIntro() {
	<section class="slide" data-tone="red" data-duration="4000">
		<img class="opener-art animate-on-enter delay-200" src="/static/img/emoji/1f4b8.svg" alt="" aria-hidden="true"/>
		<div class="scene is-low">
			<p class="chapter-no animate-on-enter in-fade">04 — Strafenkasse</p>
			<h2 class="headline animate-on-enter in-up delay-150 gap-s">Fehlen hat seinen <em>Preis</em>.</h2>
			<p class="lede animate-on-enter in-fade delay-400 gap-s">Ab fünf Donnerstagen am Stück wird es teuer.</p>
		</div>
	</section>
}

// StrafenPayerCard – ein Zahler mit seinen Posten.
templ StrafenPayerCard(payer viewmodels.StrafenUserView) {
	<div class={ "panel payer animate-on-enter in-up", payer.DelayClass }>
		<div class="payer-head">
			<span class="emo" aria-hidden="true">{ payer.RankDisplay }</span>
			<div class="item-body">
				<b>{ payer.Emoji } { payer.Name }</b>
			</div>
			<span class="item-num">{ payer.Total }</span>
		</div>
		<div class="payer-entries">
			for _, entry := range payer.Entries {
				<div class="payer-entry">
					<span aria-hidden="true">{ entry.ArtEmoji }</span>
					<span class="label">
						{ entry.Label }
						if entry.DateRange != "" {
							<span class="meta"> · { entry.DateRange }</span>
						}
					</span>
					<b>{ entry.Betrag }</b>
					<span aria-hidden="true">{ entry.StatusEmoji }</span>
				</div>
			}
		</div>
	</div>
}

// Strafen – Kassenstand und Top-Zahler.
templ Strafen(strafen viewmodels.StrafenView) {
	<section class="slide" data-tone="red" data-duration="8000">
		if strafen.HasStrafen {
			<div class="scene">
				<p class="eyebrow animate-on-enter in-fade">Kassenstand</p>
				<p class="display animate-on-enter in-big delay-100 gap-s">
					<span data-count-to={ fmt.Sprintf("%d", strafen.TotalSum) }>0</span><small>€</small>
				</p>
				<p class="lede animate-on-enter in-up delay-300 gap-s">
					{ fmt.Sprintf("aus %d Strafen", strafen.TotalCount) }
					if strafen.MassBier > 0 {
						· das sind <span class="hl">{ fmt.Sprintf("%d Maß", strafen.MassBier) }</span> 🍺
					}
				</p>
				<p class="section-label animate-on-enter in-fade delay-400 gap-m">Top-Zahler</p>
				<div class="list">
					for _, payer := range strafen.TopPayers {
						@StrafenPayerCard(payer)
					}
				</div>
			</div>
		} else {
			<img class="opener-art animate-on-enter delay-200" src="/static/img/emoji/1f607.svg" alt="" aria-hidden="true"/>
			<div class="scene is-low">
				<p class="eyebrow animate-on-enter in-fade">Kassenstand</p>
				<h2 class="headline animate-on-enter in-up delay-150 gap-s">Kasse <em>leer</em>!</h2>
				<p class="lede animate-on-enter in-fade delay-400 gap-s">Keine einzige Strafe dieses Jahr. Respekt.</p>
			</div>
		}
	</section>
}
