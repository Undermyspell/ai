package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// streakItem – eine Serie: wer, wie lange, wann.
templ streakItem(user viewmodels.StreakUser, tone string, weeks int, label string) {
	<div class={ "item is-tinted animate-on-enter in-left", user.DelayClass } data-tone={ tone }>
		<span class="emo" aria-hidden="true">{ user.Emoji }</span>
		<div class="item-body">
			<b>{ user.Name }</b>
			<span>{ label }</span>
			if user.DateRange != "" {
				<span class="meta">{ user.DateRange }</span>
			}
		</div>
		<span class="item-num">{ fmt.Sprintf("%d", weeks) }<small>Wo.</small></span>
	</div>
}

// AttendanceStreakCard – längste Anwesenheits-Serie.
templ AttendanceStreakCard(user viewmodels.StreakUser) {
	@streakItem(user, "amber", user.MaxAttendanceStreak, "am Stück da")
}

// CancellationStreakCard – längste Absage-Serie.
templ CancellationStreakCard(user viewmodels.StreakUser) {
	@streakItem(user, "cyan", user.MaxCancellationStreak, "am Stück gefehlt")
}

// Streaks – heiß gegen kalt.
templ Streaks(attendanceStreaks []viewmodels.StreakUser, cancellationStreaks []viewmodels.StreakUser) {
	<section class="slide" data-tone="amber" data-duration="7000">
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">Serien</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">Durchgezogen – in beide Richtungen</h2>
			<div class="gap-m">
				<p class="section-label animate-on-enter in-fade delay-150" data-tone="amber">🔥 Am längsten da</p>
				<div class="list">
					for _, user := range attendanceStreaks {
						@AttendanceStreakCard(user)
					}
				</div>
				<p class="section-label animate-on-enter in-fade delay-500" data-tone="cyan">🧊 Am längsten weg</p>
				<div class="list">
					for _, user := range cancellationStreaks {
						@CancellationStreakCard(user)
					}
				</div>
			</div>
		</div>
	</section>
}
