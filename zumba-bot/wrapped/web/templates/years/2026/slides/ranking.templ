package slides

import (
	"fmt"

	"github.com/michael/stammtisch-wrapped/web/templates/years/2026/viewmodels"
)

// Intro – der Auftakt: die Jahreszahl als Bühne.
templ Intro() {
	<section class="slide active" data-tone="blue" data-duration="5000">
		<img class="opener-art animate-on-enter delay-300" src="/static/img/emoji/1f37b.svg" alt="" aria-hidden="true"/>
		<div class="scene is-low">
			<p class="eyebrow animate-on-enter in-fade">Weihnachtsfeier → Weihnachtsfeier</p>
			<h1 class="display animate-on-enter in-big delay-150 gap-s">2026</h1>
			<p class="headline animate-on-enter in-up delay-450 gap-m">Euer Stammtisch-<em>Jahr</em></p>
			<p class="lede animate-on-enter in-fade delay-700 gap-s">Tippen für weiter, halten zum Pausieren.</p>
		</div>
	</section>
}

// YearStats – das Jahr in Zahlen: eine große Quote, darunter die Eckdaten.
templ YearStats(stats viewmodels.YearStatsView) {
	<section class="slide" data-tone="blue" data-duration="7000">
		<div class="scene is-center">
			<p class="eyebrow animate-on-enter in-fade">Das Jahr in Zahlen</p>
			<p class="display animate-on-enter in-big delay-100 gap-s">
				<span data-count-to={ fmt.Sprintf("%d", stats.AverageAttendanceRate) }>0</span><small>%</small>
			</p>
			<p class="lede animate-on-enter in-up delay-250 gap-s">Ø Teilnahme über alle Donnerstage</p>
			<div class="gap-l">
				@figure(stats.TotalThursdays, "Donnerstage", "", "delay-400")
				@figure(stats.TotalUsers, "Stammtischler", "", "delay-500")
				@figure(stats.TotalAttendances, "Zusagen", "is-green", "delay-600")
				@figure(stats.TotalCancellations, "Absagen", "is-red", "delay-700")
			</div>
		</div>
	</section>
}

// figure ist eine Zeile „Zahl – Bedeutung“ ohne Kachel.
templ figure(n int, label string, tone string, delay string) {
	<div class={ "figure animate-on-enter in-left", delay }>
		<span class={ "figure-num", tone } data-count-to={ fmt.Sprintf("%d", n) }>0</span>
		<span class="figure-label">{ label }</span>
	</div>
}

// RankingIntro – Kapitel Rangliste.
templ RankingIntro() {
	<section class="slide" data-tone="amber" data-duration="4000">
		<img class="opener-art animate-on-enter delay-200" src="/static/img/emoji/1f3c6.svg" alt="" aria-hidden="true"/>
		<div class="scene is-low">
			<p class="chapter-no animate-on-enter in-fade">01 — Rangliste</p>
			<h2 class="headline animate-on-enter in-up delay-150 gap-s">Wer war wirklich <em>da</em>?</h2>
			<p class="lede animate-on-enter in-fade delay-400 gap-s">Der Zuverlässigkeits-Score. Gleich gut heißt gleicher Platz – wie im Sport.</p>
		</div>
	</section>
}

// RankingCard – eine Zeile der Rangliste.
templ RankingCard(user viewmodels.RankedUser) {
	<div class={ "rank-row animate-on-enter in-left", user.DelayClass, user.Tier }>
		if user.Rank <= 3 {
			<span class="rank-place is-medal">{ user.RankDisplay }</span>
		} else {
			<span class="rank-place">{ fmt.Sprintf("%d", user.Rank) }</span>
		}
		<span class="emo" aria-hidden="true">{ user.Emoji }</span>
		<div class="rank-name">
			<b>{ user.Name }</b>
			<span>{ user.TitleEmoji } { user.Title }</span>
		</div>
		<div class="rank-pct">
			{ fmt.Sprintf("%d%%", user.AttendanceRate) }
			<small>{ user.PersonalMessage }</small>
		</div>
		<div class={ "meter", user.BarTone }><i class="animate-bar" style={ fmt.Sprintf("--w: %d", user.AttendanceRate) }></i></div>
		if user.FunFact != "" {
			<div class="rank-fact">{ user.FunFact }</div>
		}
	</div>
}

// rankingSlide – gemeinsamer Rahmen der drei Ranglisten-Slides.
templ rankingSlide(tone string, duration string, eyebrow string, title string, users []viewmodels.RankedUser) {
	<section class="slide" data-tone={ tone } data-duration={ duration }>
		<div class="scene">
			<p class="eyebrow animate-on-enter in-fade">{ eyebrow }</p>
			<h2 class="title animate-on-enter in-up delay-100 gap-xs">{ title }</h2>
			<div class="list gap-m">
				for _, user := range users {
					@RankingCard(user)
				}
			</div>
		</div>
	</section>
}

// Top5 – die Spitze.
templ Top5(users []viewmodels.RankedUser) {
	@rankingSlide("amber", "8000", "Rangliste · Spitze", "Die Zuverlässigsten", users)
}

// MidRanking – das Mittelfeld.
templ MidRanking(users []viewmodels.RankedUser) {
	@rankingSlide("blue", "6000", "Rangliste · Mittelfeld", "Solide dabei", users)
}

// BottomRanking – Luft nach oben.
templ BottomRanking(users []viewmodels.RankedUser) {
	@rankingSlide("neutral", "6000", "Rangliste · Verfolger", "Da geht noch was", users)
}
