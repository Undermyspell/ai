# Copy to .env and adjust. .env is gitignored.

DB_HOST=192.168.178.46
DB_PORT=5433
DB_NAME=zumba
DB_USER=n8n
DB_PASSWORD=n8n_password
DB_SSLMODE=disable

PORT=8080

# whatsapp-bot Basis-URL für die Bot-Test-Seite
BOT_URL=http://localhost:8080

# Stammtischjahre werden in der Tabelle public.seasons gepflegt (Label,
# start_date, end_date) – es gibt keine Zeitraum-Env-Variablen mehr.

# classifier-service für die ML-Test-Seite (/ml-test). Leer = die Seite meldet
# "Kein classifier-service konfiguriert". ./dev-local.sh startet den Service
# auf :8085 und setzt die Variable selbst; nur für ein alleinstehendes
# `make dev` hier eintragen — dann den Service separat starten:
#   cd ../classifier-service && PORT=8085 go run ./cmd/server
# CLASSIFIER_URL=http://localhost:8085

# Login. Ohne ADMIN_PASSWORD ist der Login aus – so laufen `make dev` und die
# Tests ohne Anmeldung. Im Cluster kommen Passwort und Session-Schlüssel aus
# dem SealedSecret admin-ui-secrets.
# ADMIN_USER=admin
# ADMIN_PASSWORD=lokales-testpasswort
# SESSION_SECRET signiert das Session-Cookie; leer = pro Start zufällig
# (Neustart erzwingt neuen Login).
# SESSION_SECRET=
# Das Session-Cookie ist HttpOnly + SameSite=Strict + Secure. Lokal läuft der
# Server über http, dort muss Secure aus sein – sonst verwirft der Browser das
# Cookie und der Login springt endlos auf sich selbst zurück.
COOKIE_SECURE=false
