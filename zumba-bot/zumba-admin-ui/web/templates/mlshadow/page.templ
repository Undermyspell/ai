package mlshadow

import (
	"fmt"
	"strconv"

	"github.com/michael/zumba-admin-ui/internal/store"
)

// VM bündelt alles, was die Shadow-Seite rendert.
type VM struct {
	Stats        store.MLShadowStats
	Messages     []store.MLMessage
	OnlyDisagree bool
}

templ Page(vm VM) {
	@Stats(vm.Stats)
	<p class="card-sub" style="margin-top:-8px">
		Das eigene Modell klassifiziert jede Nachricht parallel zu Gemini. Abweichungen
		prüfen und das korrekte Label setzen — geprüfte Einträge werden Trainings- und Testdaten.
	</p>
	@List(vm)
}

templ Stats(st store.MLShadowStats) {
	<section class="grid-4">
		<div class="tile"><div class="tile-body"><div class="tile-label">Nachrichten</div><div class="tile-value is-big">{ strconv.Itoa(st.Total) }</div></div></div>
		<div class="tile"><div class="tile-body"><div class="tile-label">Modell-Antworten</div><div class="tile-value is-big">{ strconv.Itoa(st.WithModel) }</div></div></div>
		<div class="tile">
			<div class="tile-body">
				<div class="tile-label">Übereinstimmung</div>
				<div class="tile-value is-big t-blue">{ agreementPct(st) }</div>
				if len(st.PerLabel) > 0 {
					<div class="ml-labels" style="margin-top:4px">
						for _, ls := range st.PerLabel {
							<span class={ "lbl", "lbl-" + ls.Label } title={ fmt.Sprintf("%d/%d einig", ls.Agree, ls.Total) }>{ labelText(ls.Label) } { labelPct(ls) }</span>
						}
					</div>
				}
			</div>
		</div>
		<div class="tile"><div class="tile-body"><div class="tile-label">Geprüft</div><div class="tile-value is-big t-green">{ strconv.Itoa(st.Verified) }</div></div></div>
	</section>
}

templ List(vm VM) {
	<div id="ml-list" class="stack" style="gap:12px">
		<div class="toolbar">
			if vm.OnlyDisagree {
				<button type="button" class="btn btn-ghost btn-sm" style="background:var(--sel)" hx-get="/ml-shadow?filter=alle" hx-target="#ml-list" hx-select="#ml-list" hx-swap="outerHTML">Alle anzeigen</button>
				<span class="card-sub">Nur Abweichungen &amp; Modell-Ausfälle</span>
			} else {
				<button type="button" class="btn btn-ghost btn-sm" hx-get="/ml-shadow?filter=disagree" hx-target="#ml-list" hx-select="#ml-list" hx-swap="outerHTML">Nur Abweichungen</button>
			}
			<button type="button" class="btn btn-ghost btn-sm" hx-get={ refreshHref(vm) } hx-target="#ml-list" hx-select="#ml-list" hx-swap="outerHTML">↻ Aktualisieren</button>
		</div>
		if len(vm.Messages) == 0 {
			<section class="card">
				<div class="empty">
					<span class="empty-ico" aria-hidden="true">🤖</span>
					<p>Noch keine Shadow-Einträge. Sobald der Bot donnerstags Nachrichten klassifiziert, erscheinen sie hier.</p>
				</div>
			</section>
		} else {
			<div class="ml-rows">
				for _, m := range vm.Messages {
					@Row(m)
				}
			</div>
		}
	</div>
}

templ Row(m store.MLMessage) {
	<div class={ "ml-row", rowClass(m) } id={ rowID(m.ID) }>
		<div class="ml-row-head">
			<span class="ml-time">{ m.CreatedAt.Format("02.01. 15:04") }</span>
			<span class="ml-user">{ orDash(m.UserName) }</span>
			<span class="ml-agree">{ agreeGlyph(m) }</span>
		</div>
		<div class="ml-msg">{ m.Message }</div>
		<div class="ml-labels">
			Gemini
			<span class={ "lbl", "lbl-" + m.GeminiLabel }>{ labelText(m.GeminiLabel) }</span>
			Modell
			if m.ModelLabel != nil {
				<span class={ "lbl", "lbl-" + *m.ModelLabel }>{ labelText(*m.ModelLabel) }</span>
				if m.ModelConfidence != nil {
					<span class="ml-conf">{ fmt.Sprintf("%.0f %%", *m.ModelConfidence*100) }</span>
				}
			} else {
				<span class="lbl lbl-missing">keine Antwort</span>
			}
		</div>
		<div class="ml-verify">
			if m.Verified {
				<span class="ml-verified">✔ geprüft: { labelText(effectiveLabel(m)) }</span>
				if m.ModelLabel != nil {
					@verdict("Modell", *m.ModelLabel == effectiveLabel(m))
				}
				@verdict("Gemini", m.GeminiLabel == effectiveLabel(m))
			} else {
				<span class="cap">Richtig ist:</span>
				for _, l := range []string{"true", "false", "invalid"} {
					<button
						type="button"
						class="ml-pick"
						hx-post={ verifyHref(m.ID, l) }
						hx-target={ "#" + rowID(m.ID) }
						hx-swap="outerHTML"
					>
						if l == m.GeminiLabel {
							{ "✓ " + labelText(l) + " (wie Gemini)" }
						} else {
							{ labelText(l) }
						}
					</button>
				}
			}
		</div>
	</div>
}

templ verdict(who string, ok bool) {
	if ok {
		<span class="pill is-solid-green">{ who } ✓</span>
	} else {
		<span class="pill is-solid-red">{ who } ✗</span>
	}
}

func rowID(id int64) string { return "ml-row-" + strconv.FormatInt(id, 10) }

func verifyHref(id int64, label string) string {
	return "/ml-shadow/verify/" + strconv.FormatInt(id, 10) + "?label=" + label
}

func refreshHref(vm VM) string {
	if vm.OnlyDisagree {
		return "/ml-shadow?filter=disagree"
	}
	return "/ml-shadow"
}

func isDisagree(m store.MLMessage) bool { return m.Agree == nil || !*m.Agree }

func rowClass(m store.MLMessage) string {
	switch {
	case m.Verified:
		return "is-ok"
	case isDisagree(m):
		return "is-bad"
	default:
		return ""
	}
}

func agreeGlyph(m store.MLMessage) string {
	switch {
	case m.Agree == nil:
		return "⚠ Modell ohne Antwort"
	case *m.Agree:
		return "✓ einig"
	default:
		return "✗ Abweichung"
	}
}

// effectiveLabel: nach Prüfung gilt das korrigierte Label, sonst Gemini.
func effectiveLabel(m store.MLMessage) string {
	if m.CorrectedLabel != nil {
		return *m.CorrectedLabel
	}
	return m.GeminiLabel
}

func labelText(l string) string {
	switch l {
	case "true":
		return "Zusage"
	case "false":
		return "Absage"
	case "invalid":
		return "invalid"
	default:
		return "—"
	}
}

func agreementPct(st store.MLShadowStats) string {
	if st.WithModel == 0 {
		return "—"
	}
	return fmt.Sprintf("%.0f %%", float64(st.Agree)/float64(st.WithModel)*100)
}

func labelPct(ls store.MLLabelStat) string {
	if ls.Total == 0 {
		return "—"
	}
	return fmt.Sprintf("%.0f %%", float64(ls.Agree)/float64(ls.Total)*100)
}

func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}
