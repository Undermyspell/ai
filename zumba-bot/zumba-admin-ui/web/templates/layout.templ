package templates

import "github.com/michael/zumba-admin-ui/web/templates/partials"

type PageMeta struct {
	Title     string
	ActiveNav string // "dashboard" | "members" | "days" | "excluded"
	MockMode  bool

	// AuthEnabled: Login ist konfiguriert – dann bekommt der Header einen
	// Abmelden-Knopf.
	AuthEnabled bool

	// Jahresbezug. Nur Seiten mit Auswertungszeitraum füllen das – Bot-Test
	// und die ML-Seiten lassen es leer, dann entfällt der Umschalter.
	Season         string // Label des angezeigten Stammtischjahres, z. B. "2026"
	SeasonRange    string // "1. Dez – 30. Nov"
	SeasonArchived bool   // Jahr vorbei: Ansicht ist read-only
	Seasons        []SeasonLink
}

// SeasonLink ist ein Eintrag des Jahres-Umschalters.
type SeasonLink struct {
	Label  string
	Href   string
	Active bool
}

templ Layout(meta PageMeta) {
	<!DOCTYPE html>
	<html lang="de" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ meta.Title } · Zumba Admin</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<script src="/static/js/theme.js"></script>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/toast.js" defer></script>
		</head>
		<body>
			<div class="app">
				<header class="app-header">
					<a href="/dashboard" class="app-brand">
						<span class="glyph">𝔃</span>
						<span class="wordmark">Zumba</span>
						<span class="tag">Logbuch</span>
					</a>
					<div class="app-actions">
						@partials.ThemeToggle()
						if meta.AuthEnabled {
							<form method="post" action="/logout">
								<button class="logout-button" type="submit" title="Abmelden">
									<span class="icon" aria-hidden="true">⏻</span>
									<span class="label">Abmelden</span>
								</button>
							</form>
						}
					</div>
				</header>
				@partials.Nav(meta.ActiveNav)
				<main class="app-main">
					if meta.MockMode {
						@partials.Banner("Mock-Daten aktiv – keine Verbindung zur Datenbank.")
					}
					if meta.Season != "" {
						@seasonPicker(meta)
					}
					if meta.SeasonArchived {
						@partials.Banner("Stammtischjahr " + meta.Season + " ist abgeschlossen – Archivansicht, keine Änderungen möglich.")
					}
					{ children... }
				</main>
				<div id="toast-stack" class="toast-stack" aria-live="polite"></div>
			</div>
		</body>
	</html>
}

// seasonPicker zeigt das angezeigte Stammtischjahr und die Umschalt-Links auf
// die übrigen (Archiv). Der Link behält den aktuellen Pfad und tauscht nur
// ?jahr= aus.
templ seasonPicker(meta PageMeta) {
	<nav class="season-picker" aria-label="Stammtischjahr">
		<span class="season-range">{ meta.SeasonRange }</span>
		<ul>
			for _, s := range meta.Seasons {
				<li>
					<a
						href={ templ.SafeURL(s.Href) }
						class={ "season-link", templ.KV("is-active", s.Active) }
						if s.Active {
							aria-current="page"
						}
					>{ s.Label }</a>
				</li>
			}
		</ul>
	</nav>
}
