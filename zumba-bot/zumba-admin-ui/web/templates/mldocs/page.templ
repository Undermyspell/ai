package mldocs

templ Page() {
	<div class="page-header enter">
		<div class="eyebrow">ML-Klassifikator</div>
		<h1>Doku</h1>
		<p class="meta">Wie das eigene Klassifikations-Modell funktioniert, trainiert und getestet wird.</p>
	</div>
	<article class="ml-docs enter">
		@templ.Raw(HTML())
	</article>
}
