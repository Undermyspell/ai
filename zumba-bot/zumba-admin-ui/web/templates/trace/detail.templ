package trace

import "github.com/michael/zumba-admin-ui/internal/store"

templ Detail(t store.Trace) {
	<a class="back-link" href="/trace">← Verlauf</a>
	<section class="card">
		<div class="card-head" style="margin-bottom:14px">
			<div>
				<div class="card-title">Event #{ itoa(t.ID) }</div>
				<div class="card-sub">{ FmtTime(t.CreatedAt) } · { orDash(t.UserName) }</div>
			</div>
			if t.HasError {
				<span class="pill is-red">⚠ Fehler im Verlauf</span>
			}
		</div>
		<dl class="facts">
			<div><dt>Pfad</dt><dd>{ PathIcon(t.Path) } { PathLabel(t.Path) }</dd></div>
			if t.Classification != "" {
				<div><dt>Klassifizierung</dt><dd>{ ClassLabel(t.Classification) } <span class="muted">({ t.Classification })</span></dd></div>
			}
			<div><dt>Aktion</dt><dd>{ ActionLabel(t.Action) }</dd></div>
			<div><dt>Typ</dt><dd class="is-mono">{ orDash(t.MessageType) }</dd></div>
		</dl>
		if t.Message != "" {
			<div class="quote" style="margin-top:16px">
				<span class="cap">Nachricht</span>
				<p>{ t.Message }</p>
			</div>
		}
	</section>
	<section class="card card-flush">
		<div class="flow-card-head">
			<div class="card-title">Verarbeitungspfad</div>
			<div class="flow-legend">
				<span class="lg taken">genommen</span>
				<span class="lg skipped">übersprungen</span>
				<span class="lg error">Fehler</span>
			</div>
		</div>
		@FlowGraph(BuildGraph(t.Steps))
		if t.RawPayload != "" {
			<details class="raw" style="border-top:1px solid var(--line)">
				<summary>{ "{ }" } Roh-Payload (Evolution-Event)</summary>
				<pre>{ t.RawPayload }</pre>
			</details>
		}
	</section>
}
