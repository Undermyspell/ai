package mltest

import (
	"fmt"
	"strconv"

	"github.com/michael/zumba-admin-ui/internal/store"
)

templ Page(tests []store.MLTestMessage, classifierConfigured bool) {
	<section class="card">
		<div class="card-title">Nachricht klassifizieren</div>
		<div class="card-sub">
			Eintippen → das eigene Modell antwortet. Danach bewerten: passt, oder das richtige
			Label hinterlegen. Bewertete Einträge fließen als Trainingsdaten in die nächste Modell-Version.
		</div>
		if classifierConfigured {
			<form
				class="ml-input"
				hx-post="/ml-test/run"
				hx-target="#mltest-list"
				hx-select="#mltest-list"
				hx-swap="outerHTML"
				hx-on::after-request="if(event.detail.successful) this.reset()"
			>
				<input class="input" type="text" name="message" required autocomplete="off" placeholder="z.B. „muss mi heit obmeldn ❌“ oder „bin doch dabei 🍻“" aria-label="Nachricht"/>
				<button type="submit" class="btn btn-primary">Klassifizieren</button>
			</form>
		} else {
			<div class="empty" style="padding:24px 8px 8px">
				<span class="empty-ico" aria-hidden="true">🔌</span>
				<p>Kein classifier-service konfiguriert (CLASSIFIER_URL fehlt).</p>
			</div>
		}
	</section>
	@List(tests)
}

templ List(tests []store.MLTestMessage) {
	<div id="mltest-list" class="ml-rows">
		if len(tests) == 0 {
			<section class="card">
				<div class="empty">
					<span class="empty-ico" aria-hidden="true">🧪</span>
					<p>Noch keine Testfälle. Oben eine Nachricht eintippen.</p>
				</div>
			</section>
		} else {
			for _, t := range tests {
				@Row(t)
			}
		}
	</div>
}

templ Row(t store.MLTestMessage) {
	<div class={ "ml-row", templ.KV("is-ok", isCorrect(t)), templ.KV("is-bad", isWrong(t)) } id={ rowID(t.ID) }>
		<div class="ml-row-head">
			<span class="ml-time">{ t.CreatedAt.Format("02.01. 15:04") }</span>
			switch  {
				case t.ExpectedLabel == nil:
					<span class="pill is-dashed-blue">offen — bitte bewerten</span>
				case *t.ExpectedLabel == t.ModelLabel:
					<span class="pill is-solid-green">✓ PASST</span>
				default:
					<span class="pill is-solid-red">✗ FALSCH</span>
			}
			<button
				type="button"
				class="ml-del"
				title="Testfall löschen"
				aria-label="Testfall löschen"
				hx-delete={ "/ml-test/" + strconv.FormatInt(t.ID, 10) }
				hx-target={ "#" + rowID(t.ID) }
				hx-swap="outerHTML"
				hx-confirm="Testfall wirklich löschen?"
			>🗑</button>
		</div>
		<div class="ml-msg">{ t.Message }</div>
		<div class="ml-labels">
			Modell
			<span class={ "lbl", "lbl-" + t.ModelLabel }>{ labelText(t.ModelLabel) }</span>
			<span class="ml-conf">{ fmt.Sprintf("%.0f %%", t.ModelConfidence*100) }</span>
			if t.ExpectedLabel != nil && *t.ExpectedLabel != t.ModelLabel {
				richtig wäre
				<span class={ "lbl", "lbl-" + *t.ExpectedLabel }>{ labelText(*t.ExpectedLabel) }</span>
			}
		</div>
		if t.ExpectedLabel == nil {
			<div class="ml-verify">
				<span class="cap">Richtig ist:</span>
				for _, l := range []string{"true", "false", "invalid"} {
					<button type="button" class="ml-pick" hx-post={ judgeHref(t.ID, l) } hx-target={ "#" + rowID(t.ID) } hx-swap="outerHTML">
						if l == t.ModelLabel {
							{ "✓ " + labelText(l) + " (wie Modell)" }
						} else {
							{ labelText(l) }
						}
					</button>
				}
			</div>
		}
	</div>
}

func rowID(id int64) string { return "mltest-row-" + strconv.FormatInt(id, 10) }

func judgeHref(id int64, label string) string {
	return "/ml-test/judge/" + strconv.FormatInt(id, 10) + "?label=" + label
}

func isCorrect(t store.MLTestMessage) bool {
	return t.ExpectedLabel != nil && *t.ExpectedLabel == t.ModelLabel
}

func isWrong(t store.MLTestMessage) bool {
	return t.ExpectedLabel != nil && *t.ExpectedLabel != t.ModelLabel
}

func labelText(l string) string {
	switch l {
	case "true":
		return "Zusage"
	case "false":
		return "Absage"
	case "invalid":
		return "invalid"
	default:
		return "—"
	}
}
