package bottest

type PageVM struct {
	DefaultKind string // "statistik"
	DefaultJSON string // pretty example for DefaultKind
}

type styleOption struct{ ID, Label string }

// cardStyleOptions spiegelt report.CardStyles() im Bot — die Bild-Designs.
// "wrapped" ist das Live-Design, der Rest ist reine Testspielwiese.
var cardStyleOptions = []styleOption{
	{"wrapped", "Wrapped (live)"},
	{"bierdeckel", "Bierdeckel hell"},
	{"bierdeckel-dunkel", "Bierdeckel dunkel"},
	{"tafel", "Kreidetafel"},
	{"masskrug", "Maßkrug"},
	{"zeitung", "Zeitung"},
	{"arena", "Arena"},
}

// styleOptions spiegelt report.Styles() im Bot. "klassik" ist die Live-Nachricht.
var styleOptions = []styleOption{
	{"klassik", "Klassik (live)"},
	{"podium", "Podium"},
	{"kompakt", "Kompakt"},
	{"tabelle", "Scoreboard (Tabelle)"},
	{"race", "Rennen"},
	{"minimal", "Minimal"},
}

// szenarien sind die vier Testläufe. Die ersten drei schicken eine
// Beispiel-Nachricht an /test, "wochenreport" ruft /weekly-report auf –
// deshalb hat nur es kein Beispiel-JSON.
type szenario struct {
	ID, Icon, Label, Hint string
	HasPayload            bool
	HasOutput             bool // erzeugt eine Statistik (Ausgabe-Format wählbar)
}

var szenarien = []szenario{
	{"statistik", "📊", "Statistik", "Rangliste auf Zuruf", true, true},
	{"absage", "🚫", "Absage", "Klassifikation prüfen", true, false},
	{"zusage", "✅", "Zusage", "Klassifikation prüfen", true, false},
	{"wochenreport", "📅", "Wochenreport", "Donnerstag 21:00", false, true},
}

templ Page(vm PageVM) {
	<div class="page-header enter">
		<div class="eyebrow">WhatsApp-Bot</div>
		<h1>Bot-Test</h1>
		<p class="meta">Szenario wählen, Optionen setzen, Test starten. Es geht nie etwas an die Zumba-Gruppe.</p>
	</div>
	<form
		class="bt enter"
		hx-post="/bot-test/run"
		hx-target="#bot-response"
		hx-swap="innerHTML"
		hx-indicator="#bt-start"
	>
		<section class="bt-panel">
			<div class="bt-head">
				<span class="bt-step"></span>
				<h2>Szenario</h2>
			</div>
			<div class="seg seg-wide" role="radiogroup" aria-label="Szenario">
				for _, s := range szenarien {
					@szenarioOption(s, vm.DefaultKind)
				}
			</div>
		</section>
		<section class="bt-panel only-payload">
			<div class="bt-head">
				<span class="bt-step"></span>
				<h2>Beispiel-Nachricht</h2>
				<span class="bt-hint">Evolution-Webhook-Event — frei editierbar</span>
			</div>
			<textarea id="bot-json" name="payload" rows="14" spellcheck="false">{ vm.DefaultJSON }</textarea>
		</section>
		<div class="bt-grid">
			<section class="bt-panel only-output">
				<div class="bt-head">
					<span class="bt-step"></span>
					<h2>Ausgabe</h2>
				</div>
				<div class="seg" role="radiogroup" aria-label="Ausgabeformat">
					<label class="seg-opt">
						<input type="radio" name="format" value="text" id="fmt-text" checked/>
						<span class="seg-face"><span class="seg-ico">💬</span>Nachricht</span>
					</label>
					<label class="seg-opt">
						<input type="radio" name="format" value="image" id="fmt-image"/>
						<span class="seg-face"><span class="seg-ico">🖼️</span>Bild</span>
					</label>
				</div>
				<div class="bt-field only-text">
					<label for="bot-style">Text-Design</label>
					<select id="bot-style" name="style" class="bt-select">
						for _, o := range styleOptions {
							<option value={ o.ID }>{ o.Label }</option>
						}
					</select>
					<p class="bt-note">Live geht immer „Klassik" raus.</p>
				</div>
				<div class="bt-field only-image">
					<label for="bot-card-style">Bild-Design</label>
					<select id="bot-card-style" name="cardStyle" class="bt-select">
						for _, o := range cardStyleOptions {
							<option value={ o.ID }>{ o.Label }</option>
						}
					</select>
					<p class="bt-note">PNG-Karte über den Renderer. Live läuft immer „Wrapped".</p>
				</div>
			</section>
			<section class="bt-panel">
				<div class="bt-head">
					<span class="bt-step"></span>
					<h2>Versand</h2>
				</div>
				<label class="opt-card">
					<input type="radio" name="mode" value="dryrun" checked/>
					<span class="oc-title">Dry-Run</span>
					<span class="oc-hint">Nur hier im UI — nichts gesendet, nichts in die DB geschrieben.</span>
				</label>
				<label class="opt-card">
					<input type="radio" name="mode" value="preview"/>
					<span class="oc-title">📱 Vorschau an meine Nummer</span>
					<span class="oc-hint">Zusätzlich als echte WhatsApp an dich — nie an die Gruppe.</span>
				</label>
				<div class="bt-field">
					<label for="bt-date">Stichtag <span class="bt-optional">optional</span></label>
					<input type="date" id="bt-date" name="date" class="bt-input"/>
					<p class="bt-note">Simuliert den Versandtag für Rangliste und Strafen. Beim Wochenreport erzwingt ein Stichtag den Dry-Run.</p>
				</div>
			</section>
		</div>
		<div class="bt-bar">
			<button type="submit" id="bt-start" class="btn-primary">Test starten</button>
			<span class="bt-bar-note">Echte Gruppen-Nachrichten entstehen nur durch reale „statistik"-Anfragen und den Wochenreport-CronJob.</span>
		</div>
		<section class="bt-result">
			<div class="bt-head">
				<h2>Ergebnis</h2>
			</div>
			<div id="bot-response" class="bot-response">
				<p class="bt-empty">Noch kein Durchlauf. Der Bot verarbeitet die Anfrage komplett — Klassifikation, DB-Wirkung, Antwort — und zeigt sie hier.</p>
			</div>
		</section>
	</form>
}

templ szenarioOption(s szenario, active string) {
	<label class="seg-opt">
		if s.HasPayload {
			<input
				type="radio"
				name="szenario"
				value={ s.ID }
				id={ "sz-" + s.ID }
				checked?={ s.ID == active }
				hx-get={ "/bot-test/example/" + s.ID }
				hx-target="#bot-json"
				hx-swap="innerHTML"
				hx-trigger="change"
			/>
		} else {
			<input type="radio" name="szenario" value={ s.ID } id={ "sz-" + s.ID }/>
		}
		<span class="seg-face">
			<span class="seg-ico">{ s.Icon }</span>
			<span class="seg-text">
				{ s.Label }
				<small>{ s.Hint }</small>
			</span>
		</span>
	</label>
}
