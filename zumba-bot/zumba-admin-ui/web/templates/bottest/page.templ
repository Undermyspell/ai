package bottest

type PageVM struct {
	DefaultKind string // "statistik"
	DefaultJSON string // pretty example for DefaultKind
	// Model ist das aktive Hauptmodell (nur Anzeige im Verarbeitungspfad).
	Model string
	Time  string // Uhrzeit an der Sprechblase
}

type styleOption struct{ ID, Label string }

// cardStyleOptions spiegelt report.CardStyles() im Bot — die Bild-Designs.
// "wrapped" ist das Live-Design, der Rest ist reine Testspielwiese.
var cardStyleOptions = []styleOption{
	{"wrapped", "Wrapped (live)"},
	{"bierdeckel", "Bierdeckel hell"},
	{"bierdeckel-dunkel", "Bierdeckel dunkel"},
	{"tafel", "Kreidetafel"},
	{"masskrug", "Maßkrug"},
	{"zeitung", "Zeitung"},
	{"arena", "Arena"},
	{"stempelkarte", "Treuekarte"},
	{"sammelkarten", "Sammelalbum"},
	{"formular", "Amtsformular"},
}

// styleOptions spiegelt report.Styles() im Bot. "klassik" ist die Live-Nachricht.
var styleOptions = []styleOption{
	{"klassik", "Klassik (live)"},
	{"podium", "Podium"},
	{"kompakt", "Kompakt"},
	{"tabelle", "Scoreboard (Tabelle)"},
	{"race", "Rennen"},
	{"minimal", "Minimal"},
}

// szenarien sind die vier Testläufe. Die ersten drei schicken eine
// Beispiel-Nachricht an /test, "wochenreport" ruft /weekly-report auf –
// deshalb hat nur es kein Beispiel-JSON.
type szenario struct {
	ID, Icon, Label, Hint string
	HasPayload            bool
}

var szenarien = []szenario{
	{"statistik", "📊", "Statistik", "Rangliste auf Zuruf", true},
	{"absage", "🚫", "Absage", "Klassifikation prüfen", true},
	{"zusage", "✅", "Zusage", "Klassifikation prüfen", true},
	{"wochenreport", "📅", "Wochenreport", "Donnerstag 21:00", false},
}

templ Page(vm PageVM) {
	<form
		class="bot-grid"
		hx-post="/bot-test/run"
		hx-target="#bot-response"
		hx-swap="innerHTML"
		hx-indicator="#bt-start"
	>
		<div class="card bot-settings">
			<div>
				<div class="cap">Szenario</div>
				<div class="scen-list" role="radiogroup" aria-label="Szenario">
					for _, s := range szenarien {
						@szenarioOption(s, vm.DefaultKind)
					}
				</div>
			</div>
			<div class="only-output">
				<div class="cap">Ausgabe</div>
				<div class="seg" role="radiogroup" aria-label="Ausgabeformat">
					<label><input type="radio" name="format" value="text" id="fmt-text" checked/><span class="seg-face">💬 Nachricht</span></label>
					<label><input type="radio" name="format" value="image" id="fmt-image"/><span class="seg-face">🖼️ Bild</span></label>
				</div>
				<label class="field only-text">
					<span class="field-label">Text-Design</span>
					<select class="select" name="style">
						for _, o := range styleOptions {
							<option value={ o.ID }>{ o.Label }</option>
						}
					</select>
					<span class="hint">Live geht immer „Klassik" raus.</span>
				</label>
				<label class="field only-image">
					<span class="field-label">Bild-Design</span>
					<select class="select" name="cardStyle">
						for _, o := range cardStyleOptions {
							<option value={ o.ID }>{ o.Label }</option>
						}
					</select>
					<span class="hint">PNG-Karte über den Renderer. Live läuft immer „Wrapped".</span>
				</label>
			</div>
			<div>
				<div class="cap">Versand</div>
				<div class="seg" role="radiogroup" aria-label="Versand">
					<label><input type="radio" name="mode" value="dryrun" id="mode-dryrun" checked/><span class="seg-face">Dry-Run</span></label>
					<label><input type="radio" name="mode" value="preview" id="mode-preview"/><span class="seg-face">📱 An mich</span></label>
				</div>
				<p class="hint only-dry">Nur hier im UI — nichts gesendet, nichts in die DB geschrieben.</p>
				<p class="hint only-preview">Zusätzlich als echte WhatsApp an deine Nummer — nie an die Gruppe.</p>
				<label class="field">
					<span class="field-label">Stichtag <span style="opacity:.7">optional</span></span>
					<input class="input" type="date" name="date"/>
					<span class="hint">Simuliert den Versandtag für Rangliste und Strafen. Beim Wochenreport erzwingt ein Stichtag den Dry-Run.</span>
				</label>
			</div>
			<button type="submit" id="bt-start" class="btn btn-primary" style="padding:12px;font-size:14px;font-weight:800">▶ Test starten</button>
			<p class="hint">Es geht nie etwas an die Gruppe. Echte Gruppen-Nachrichten entstehen nur durch reale „statistik"-Anfragen und den Wochenreport-CronJob.</p>
		</div>
		<div class="card chat">
			<div class="chat-head">
				<span class="chat-avatar" aria-hidden="true">🍻</span>
				<div>
					<div class="chat-title">Zumba-Gruppe <small>· Simulation</small></div>
					<div class="chat-sub">Donnerstag</div>
				</div>
				<span class="chat-mode">
					<span class="pill pill-mono is-blue only-dry">DRY-RUN</span>
					<span class="pill pill-mono is-amber only-preview">VORSCHAU → eigene Nummer</span>
				</span>
			</div>
			<div class="chat-body">
				<div class="msg-in only-payload">
					<span class="msg-avatar" aria-hidden="true">🍺</span>
					<div class="bubble-in">
						<div class="bubble-sender" id="bot-sender">Max</div>
						<textarea id="bot-msg" rows="2" aria-label="Nachricht (bearbeitbar)" spellcheck="false"></textarea>
						<div class="bubble-foot"><span>✎ Text direkt bearbeiten</span><span>{ vm.Time }</span></div>
					</div>
				</div>
				<div class="cron-chip only-cron">⏰ CronJob · Donnerstag 21:00 · Wochenreport</div>
				<div id="bot-response" aria-live="polite"></div>
				<div class="bot-idle">Noch kein Durchlauf – links Szenario wählen und „Test starten".</div>
			</div>
			<details class="chat-json only-payload">
				<summary>{ "{ }" } Webhook-JSON (Evolution-Event) anzeigen</summary>
				<textarea id="bot-json" name="payload" rows="14" spellcheck="false" aria-label="Webhook-JSON">{ vm.DefaultJSON }</textarea>
			</details>
		</div>
		<div class="card bot-path" style="padding:20px">
			<div class="card-title-sm">Verarbeitungspfad</div>
			<div class="card-sub path-note-wait">füllt sich nach dem Testlauf</div>
			<div class="card-sub path-note-done">so lief die Verarbeitung</div>
			for _, s := range szenarien {
				<div class="timeline steps-wait" data-for={ s.ID }>
					for _, st := range WaitingSteps(s.ID, vm.Model) {
						@step(st)
					}
				</div>
			}
			<div id="bot-path-result"></div>
		</div>
	</form>
}

templ szenarioOption(s szenario, active string) {
	<label class="scen">
		if s.HasPayload {
			<input
				type="radio"
				name="szenario"
				value={ s.ID }
				id={ "sz-" + s.ID }
				checked?={ s.ID == active }
				hx-get={ "/bot-test/example/" + s.ID }
				hx-target="#bot-json"
				hx-swap="innerHTML"
				hx-trigger="change"
			/>
		} else {
			<input type="radio" name="szenario" value={ s.ID } id={ "sz-" + s.ID }/>
		}
		<span class="scen-ico" aria-hidden="true">{ s.Icon }</span>
		<span>
			<span class="scen-label">{ s.Label }</span>
			<span class="scen-hint">{ s.Hint }</span>
		</span>
		<span class="scen-radio" aria-hidden="true"></span>
	</label>
}

templ step(st Step) {
	<div class={ "tl-step", "is-" + st.State }>
		<span class="tl-rail"><span class="tl-dot"></span><span class="tl-line"></span></span>
		<div class="tl-body">
			<div class="tl-label">{ st.Label }</div>
			if st.Detail != "" {
				<div class="tl-detail">{ st.Detail }</div>
			}
		</div>
	</div>
}
