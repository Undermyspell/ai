package bottest

// Step ist ein Punkt im Verarbeitungspfad. State: wait | done | skipped | error.
type Step struct {
	Label  string
	Detail string
	State  string
}

// WaitingSteps sind die Schritte eines Szenarios vor dem Testlauf.
func WaitingSteps(szenario, model string) []Step {
	wait := func(labels ...string) []Step {
		out := make([]Step, len(labels))
		for i, l := range labels {
			out[i] = Step{Label: l, State: "wait"}
		}
		out[0].Detail = "wartet"
		return out
	}
	classifier := "Klassifikator"
	if model != "" {
		classifier += " (" + model + ")"
	}
	switch szenario {
	case "wochenreport":
		return wait("CronJob ausgelöst", "Rangliste + Strafen berechnen", "Rendern", "An Gruppe senden")
	case "absage", "zusage":
		return wait("Webhook empfangen", "„statistik“?", "Guards: Typ · Gruppe · Donnerstag", classifier, "DB-Aktion")
	default:
		return wait("Webhook empfangen", "„statistik“?", "Rangliste berechnen", "Rendern", "An Gruppe senden")
	}
}

type ResponseVM struct {
	Path           string
	Classification string
	Action         string
	Message        string
	Recipient      string
	Date           string
	UserID         string
	DryRun         bool
	PreviewTo      string
	ImageBase64    string // PNG-Karte (format=image), base64 ohne data:-Präfix
	Time           string // "20:12"
	Steps          []Step
	Meta           string // Fußzeile des Verarbeitungspfads
}

templ Response(vm ResponseVM) {
	if vm.Path == "statistik" {
		if vm.ImageBase64 != "" {
			<div class="bubble-out is-image">
				<img alt="Statistik-Karte" src={ templ.SafeURL("data:image/png;base64," + vm.ImageBase64) }/>
				<div class="bubble-out-foot">{ vm.Time } ✓✓</div>
			</div>
		} else {
			<div class="bubble-out">
				<div class="bubble-out-head">🤖 Zumba-Bot</div>
				<pre>{ vm.Message }</pre>
				<div class="bubble-out-foot">{ vm.Time } ✓✓</div>
			</div>
		}
		<div class="bot-meta">
			if vm.PreviewTo != "" {
				Als Vorschau an { vm.PreviewTo } gesendet – nicht an die Gruppe.
			} else if vm.DryRun {
				Würde an { orDash(vm.Recipient) } gehen – nicht gesendet.
			} else {
				Gesendet an { vm.Recipient }.
			}
		</div>
	} else if vm.Path == "classify" {
		<div class={ "sys-chip", clsClass(vm.Classification) }>
			{ "Klassifikation: " + classificationLabel(vm.Classification) + " → " + actionLabel(vm.Action) + " · keine Antwort in die Gruppe" }
		</div>
		if vm.Message != "" {
			<div class="bubble-out">
				<div class="bubble-out-head">🤖 Zumba-Bot</div>
				<pre>{ vm.Message }</pre>
				<div class="bubble-out-foot">{ vm.Time } ✓✓</div>
			</div>
		}
		<div class="bot-meta">User { orDash(vm.UserID) } · Datum { orDash(vm.Date) }</div>
	} else {
		<div class="sys-chip">Ignoriert – die Guards haben die Nachricht aussortiert.</div>
	}
	<div id="bot-path-result" hx-swap-oob="innerHTML">
		<div class="timeline">
			for _, st := range vm.Steps {
				@step(st)
			}
		</div>
		if vm.Meta != "" {
			<div class="tl-meta">{ vm.Meta }</div>
		}
	</div>
}

templ ErrorPanel(msg string) {
	<div class="bot-error"><strong>Fehler:</strong> { msg }</div>
	<div id="bot-path-result" hx-swap-oob="innerHTML">
		<div class="timeline">
			@step(Step{Label: "Bot-Aufruf", Detail: "fehlgeschlagen", State: "error"})
		</div>
	</div>
}

func classificationLabel(c string) string {
	switch c {
	case "true":
		return "Zusage"
	case "false":
		return "Absage"
	default:
		return "invalid"
	}
}

func clsClass(c string) string {
	switch c {
	case "true":
		return "is-green"
	case "false":
		return "is-red"
	default:
		return ""
	}
}

func actionLabel(a string) string {
	switch a {
	case "marked_absent":
		return "Absage eingetragen"
	case "marked_present":
		return "Absage entfernt"
	case "would_mark_absent":
		return "würde Absage eintragen"
	case "would_mark_present":
		return "würde Absage entfernen"
	default:
		return "keine DB-Aktion"
	}
}

func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}
