package partials

import (
	"fmt"
	"time"
)

// Pct ist die gerundete Anwesenheitsquote in Prozent.
func Pct(present, total int) int {
	if total <= 0 {
		return 0
	}
	return (present*100 + total/2) / total
}

// Tier ordnet eine Quote der Farbstufe der Kacheln und Balken zu:
// ≥85 % kräftig, ≥70 % mittel, darunter blass.
func Tier(pct int) string {
	switch {
	case pct >= 85:
		return "is-top"
	case pct >= 70:
		return "is-good"
	default:
		return ""
	}
}

var MonthsAbbr = []string{
	"Jan", "Feb", "Mär", "Apr", "Mai", "Jun",
	"Jul", "Aug", "Sep", "Okt", "Nov", "Dez",
}

var MonthsLong = []string{
	"Januar", "Februar", "März", "April", "Mai", "Juni",
	"Juli", "August", "September", "Oktober", "November", "Dezember",
}

// DM ist "09.10.".
func DM(t time.Time) string { return t.Format("02.01.") }

// KW ist die ISO-Kalenderwoche.
func KW(t time.Time) int {
	_, w := t.ISOWeek()
	return w
}

// StreakText: "🔥 +3", "🧊 -2" oder "–".
func StreakText(streak int) string {
	switch {
	case streak > 0:
		return fmt.Sprintf("🔥 +%d", streak)
	case streak < 0:
		return fmt.Sprintf("🧊 %d", streak)
	default:
		return "–"
	}
}

func StreakClass(streak int) string {
	switch {
	case streak > 0:
		return "is-hot"
	case streak < 0:
		return "is-cold"
	default:
		return ""
	}
}

// Percent rundet eine Quote aus der Rangliste.
func Percent(p float64) int { return int(p + 0.5) }

// Ring ist der CSS-Wert für einen Quoten-Ring (--pct).
func Ring(pct int) templ.SafeCSS { return templ.SafeCSS(fmt.Sprintf("--pct:%d%%", pct)) }

// Var setzt eine CSS-Variable, z. B. Var("--h", "62%").
func Var(name, value string) templ.SafeCSS { return templ.SafeCSS(name + ":" + value) }
