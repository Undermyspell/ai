package partials

import "encoding/json"

// Toggle sind die HTMX-Attribute, die die An-/Abwesenheit eines Mitglieds
// für einen Donnerstag umschalten. Der Server antwortet ohne Inhalt, nur mit
// Toast und dem Ereignis „absenceChanged" – darauf lädt sich jede Ansicht,
// die an Anwesenheiten hängt (#page, das Bottom-Sheet), selbst neu. So bleibt
// alles stimmig, egal von wo aus geschaltet wurde.
//
// Im Archiv (readOnly) bleibt der Knopf sichtbar, aber ohne Aktion; der
// Server lehnt solche Schreibversuche ohnehin ab (requireWritable).
func Toggle(userID, iso string, readOnly bool) templ.Attributes {
	if readOnly {
		return templ.Attributes{"disabled": true}
	}
	vals, _ := json.Marshal(map[string]string{"userId": userID, "date": iso})
	return templ.Attributes{
		"hx-post": "/toggle-absence",
		"hx-vals": string(vals),
		"hx-swap": "none",
	}
}

// OpenSheet sind die HTMX-Attribute, die den Donnerstag iso im Bottom-Sheet
// öffnen.
func OpenSheet(iso string) templ.Attributes {
	return templ.Attributes{
		"hx-get":    "/days/" + iso + "?sheet=1",
		"hx-target": "#sheet",
		"hx-swap":   "innerHTML",
	}
}
