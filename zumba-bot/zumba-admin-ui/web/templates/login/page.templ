package login

import "github.com/michael/zumba-admin-ui/web/templates/partials"

// VM ist das Modell der Anmeldeseite. Sie steht bewusst außerhalb des
// App-Layouts: ohne Anmeldung gibt es weder Navigation noch Jahresumschalter.
type VM struct {
	User  string // vorbelegter Benutzername (nach Fehlversuch)
	Next  string // Ziel nach erfolgreichem Login
	Error string // leer = keine Meldung
}

templ Page(vm VM) {
	<!DOCTYPE html>
	<html lang="de" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>Anmelden · Zumba Admin</title>
			@partials.Fonts()
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<script src="/static/js/theme.js"></script>
		</head>
		<body class="login-body">
			<div class="login-theme">
				@partials.ThemeToggle()
			</div>
			<main class="login-card">
				<div class="login-logo" aria-hidden="true">Z</div>
				<p class="login-eyebrow">Zumba · Admin</p>
				<h1 class="login-title">Willkommen zurück</h1>
				<p class="login-sub">Anmelden, um Donnerstage, Strafen und Bot-Tests zu verwalten.</p>
				if vm.Error != "" {
					<p class="login-error" role="alert">
						<span aria-hidden="true">✕</span>
						{ vm.Error }
					</p>
				}
				<form class="login-form" method="post" action="/login" autocomplete="on">
					<input type="hidden" name="next" value={ vm.Next }/>
					<label class="field">
						<span class="field-label">Benutzername</span>
						<input
							class="input"
							type="text"
							name="username"
							value={ vm.User }
							autocomplete="username"
							autocapitalize="none"
							spellcheck="false"
							required
							autofocus
						/>
					</label>
					<label class="field">
						<span class="field-label">Passwort</span>
						<input class="input" type="password" name="password" autocomplete="current-password" required/>
					</label>
					<button class="btn btn-primary" type="submit">Anmelden</button>
				</form>
				<p class="login-foot">Donnerstag ist Pflicht. Abmelden ist Kunst.</p>
			</main>
		</body>
	</html>
}
