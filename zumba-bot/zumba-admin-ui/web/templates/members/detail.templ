package members

import (
	"strconv"

	"github.com/michael/zumba-admin-ui/web/templates/partials"
)

type DetailVM struct {
	UserID string
	Name   string
	Emoji  string
	Rank   int // 0 = nicht in der Rangliste
	U      int
	Pct    int
	Attend int
	Away   int
	Streak int
	// Strip: ein Feld je Donnerstag, links = älter (inkl. Sperrtage).
	Strip []Dot
	// Entries: gültige Donnerstage, neueste zuerst.
	Entries []Entry
	// ReadOnly: abgeschlossenes Stammtischjahr (Archivansicht).
	ReadOnly bool
	Query    string
}

type Dot struct {
	ISO      string
	Absent   bool
	Excluded bool
	Title    string
}

type Entry struct {
	ISO     string
	Label   string // "Do., 2. Oktober 2026"
	Absent  bool
	Message string
}

templ Detail(vm DetailVM) {
	<a class="back-link" href={ templ.URL("/members" + vm.Query) }>← Alle Mitglieder</a>
	<section class="grid-4">
		<div class="tile who-tile">
			<span class="who-emo" aria-hidden="true">{ vm.Emoji }</span>
			<div>
				<div class="who-name">{ vm.Name }</div>
				<div class="tile-label">
					if vm.Rank > 0 {
						Platz { strconv.Itoa(vm.Rank) } von { strconv.Itoa(vm.U) }
					} else {
						noch nicht in der Rangliste
					}
				</div>
			</div>
		</div>
		<div class="tile">
			<div class="tile-body">
				<div class="tile-label">Quote</div>
				<div class="tile-value is-big t-blue">{ strconv.Itoa(vm.Pct) }%</div>
			</div>
		</div>
		<div class="tile">
			<div class="tile-body">
				<div class="tile-label">Da / Weg</div>
				<div class="tile-value is-big"><span class="t-green">{ strconv.Itoa(vm.Attend) }</span> / <span class="t-red">{ strconv.Itoa(vm.Away) }</span></div>
			</div>
		</div>
		<div class="tile">
			<div class="tile-body">
				<div class="tile-label">Aktuelle Serie</div>
				<div class={ "tile-value", "is-big", streakColor(vm.Streak) }>{ partials.StreakText(vm.Streak) }</div>
			</div>
		</div>
	</section>
	<section class="card">
		<div class="card-title">Verlauf</div>
		<div class="card-sub">
			if vm.ReadOnly {
				Archiv, nur Ansicht · links = älter
			} else {
				Kachel antippen schaltet um · links = älter
			}
		</div>
		<div class="strip-dots">
			for _, d := range vm.Strip {
				if d.Excluded {
					<span class="strip-dot is-excluded" title={ d.Title }></span>
				} else {
					<button
						type="button"
						class={ "strip-dot", templ.KV("is-absent", d.Absent) }
						title={ d.Title }
						aria-label={ d.Title }
						{ partials.Toggle(vm.UserID, d.ISO, vm.ReadOnly)... }
					></button>
				}
			}
		</div>
		<div class="rows entry-list">
			for _, e := range vm.Entries {
				<div class={ "entry-row", templ.KV("is-absent", e.Absent) }>
					<span class="entry-ico" aria-hidden="true">
						if e.Absent {
							✕
						} else {
							✓
						}
					</span>
					<span class="entry-text">
						<span class="entry-date">{ e.Label }</span>
						if e.Absent {
							<span class="entry-msg">{ entryMsg(e) }</span>
						}
					</span>
					<button
						type="button"
						class={ "toggle-btn", templ.KV("is-absent", e.Absent) }
						{ partials.Toggle(vm.UserID, e.ISO, vm.ReadOnly)... }
					>
						if e.Absent {
							Abgemeldet
						} else {
							Anwesend
						}
					</button>
				</div>
			}
		</div>
	</section>
}

func entryMsg(e Entry) string {
	if e.Message == "" {
		return "ohne Nachricht"
	}
	return "„" + e.Message + "“"
}

func streakColor(streak int) string {
	switch {
	case streak > 0:
		return "t-green"
	case streak < 0:
		return "t-red"
	default:
		return "faint"
	}
}
