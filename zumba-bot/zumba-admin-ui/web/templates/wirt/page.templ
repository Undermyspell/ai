package wirt

// ResultVM ist die Antwort des Bots auf einen Testlauf.
type ResultVM struct {
	Message   string
	Recipient string // Ziel des echten Versands: die Stammtisch-Gruppe
	Mentioned string // in der Nachricht markierte Nummer
	PreviewTo string // gesetzt: als Vorschau an diese Nummer gegangen
	Time      string
}

templ Page() {
	<section class="grid-side">
		<form
			class="card stack"
			hx-post="/wirt/test"
			hx-target="#wirt-result"
			hx-swap="innerHTML"
			hx-trigger="submit, load"
			hx-indicator="#wirt-start"
		>
			<div class="card-head">
				<div>
					<div class="card-title">Erinnerung testen</div>
					<div class="card-sub">Die Bitte an den Wirt, unseren Tisch freizuhalten – so sähe sie aus.</div>
				</div>
			</div>
			<div class="wirt-controls">
				<div>
					<div class="cap">Versand</div>
					<div class="seg" role="radiogroup" aria-label="Versand">
						<label><input type="radio" name="mode" value="dryrun" checked/><span class="seg-face">Dry-Run</span></label>
						<label><input type="radio" name="mode" value="preview"/><span class="seg-face">📱 An mich</span></label>
					</div>
				</div>
				<button type="submit" id="wirt-start" class="btn btn-primary">▶ Nachricht erzeugen</button>
			</div>
			<p class="hint">
				„An mich" schickt die Nachricht als echte WhatsApp an deine Testnummer und markiert dort <strong>dich</strong> statt des Wirts.
				In die Gruppe geht von hier aus nie etwas.
			</p>
			<div id="wirt-result" class="wirt-result" aria-live="polite"></div>
		</form>
		<div class="stack side-col">
			<div class="card">
				<div class="card-title-sm">Der Wirt</div>
				<p class="hint" style="margin-top:6px">
					Kein Mitglied der Runde, wird in der Nachricht aber markiert. Seine Nummer liegt wie die der Gruppe
					als <code>WIRT_JID</code> im SealedSecret <code>whatsapp-bot-secrets</code> – ändern heißt neu versiegeln und den Bot neu starten.
				</p>
			</div>
			<div class="card">
				<div class="card-title-sm">Noch offen</div>
				<p class="hint" style="margin-top:6px">
					Geplant: jeden Donnerstag um 16 Uhr in die Stammtisch-Gruppe. Der Versand ist noch nicht eingeschaltet – bisher gibt es nur diesen Test.
				</p>
			</div>
		</div>
	</section>
}

templ Result(vm ResultVM) {
	<div class="bubble-out">
		<div class="bubble-out-head">🤖 Zumba-Bot</div>
		<pre>{ vm.Message }</pre>
		<div class="bubble-out-foot">{ vm.Time } ✓✓</div>
	</div>
	<div class="bot-meta">
		if vm.PreviewTo != "" {
			Als Vorschau an { vm.PreviewTo } gesendet – nicht in die Gruppe.
		} else {
			Ginge in die Stammtisch-Gruppe – nicht gesendet.
		}
	</div>
	<div class="bot-meta">
		if vm.Mentioned != "" {
			Markiert { "@" + vm.Mentioned } (WhatsApp zeigt den Kontaktnamen)
		} else {
			WIRT_JID ist am Bot nicht gesetzt – niemand markiert
		}
	</div>
}

templ Error(msg string) {
	<div class="bot-error"><strong>Fehler:</strong> { msg }</div>
}
