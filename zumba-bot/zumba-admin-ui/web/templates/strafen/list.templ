package strafen

import (
	"fmt"
	"strconv"
	"time"

	"github.com/michael/zumba-shared/penalty"

	"github.com/michael/zumba-admin-ui/internal/store"
	"github.com/michael/zumba-admin-ui/internal/timeutil"
	"github.com/michael/zumba-admin-ui/web/templates/partials"
)

// Row ist eine bewertete Strafe für die Anzeige (gelöschte sind schon gefiltert).
type Row struct {
	ID          int64
	UserName    string
	Emoji       string
	Art         penalty.Art
	Datum       time.Time // fehltage: Serienstart; noshow: Tag
	Tage        int       // nur fehltage
	Betrag      int       // Euro
	Status      penalty.Status
	BeglichenAm *time.Time
	SichtbarBis *time.Time // beglichen: letzter Report-Tag (Folgedonnerstag)
	Sichtbar    bool       // erscheint im Report zum Stichtag
}

type Option struct {
	Value string
	Label string
}

type PageVM struct {
	Users         []store.User
	Thursdays     []Option // gültige Donnerstage (ohne Sperrtage), neueste zuerst
	Rows          []Row
	NoShowDefault int

	OffenSum     int
	OffenCount   int
	BeglichenSum int
	ReportCount  int

	// ReadOnly: abgeschlossenes Stammtischjahr (Archivansicht).
	ReadOnly bool
}

templ Page(vm PageVM) {
	@ListRegion(vm)
}

// ListRegion ist das HTMX-Swap-Ziel: Kacheln und Liste kommen nach jeder
// Aktion gemeinsam neu. Der Filter bleibt per hx-preserve stehen.
templ ListRegion(vm PageVM) {
	<div id="strafen-region" class="stack">
		<section class="grid-4">
			<div class="tile">
				<div class="tile-body">
					<div class="tile-label">Offen</div>
					<div class="tile-value is-big t-red">{ strconv.Itoa(vm.OffenSum) } €</div>
				</div>
			</div>
			<div class="tile">
				<div class="tile-body">
					<div class="tile-label">Beglichen</div>
					<div class="tile-value is-big t-green">{ strconv.Itoa(vm.BeglichenSum) } €</div>
				</div>
			</div>
			<div class="tile">
				<div class="tile-body">
					<div class="tile-label">Im nächsten Report</div>
					<div class="tile-value is-big">{ strconv.Itoa(vm.ReportCount) }</div>
				</div>
			</div>
			<div class="tile">
				<div class="tile-body">
					<div class="tile-label">Regel</div>
					<div class="tile-text">
						{ fmt.Sprintf("%d Fehltage in Folge = %d €, jede weitere Woche +%d €. No-Show manuell (%d €). Begleichen setzt den Zähler zurück.",
							penalty.MinFehltage, penalty.BasisBetrag, penalty.ProTagBetrag, penalty.NoShowDefault) }
					</div>
				</div>
			</div>
		</section>
		<section class="grid-r3">
			<div class="card card-flush strafen-card">
				<div class="s-filter">
					<div class="seg seg-inline" id="strafen-filter" hx-preserve="true" role="radiogroup" aria-label="Filter">
						<label><input type="radio" name="sf" id="sf-alle" checked/><span class="seg-face">Alle</span></label>
						<label><input type="radio" name="sf" id="sf-offen"/><span class="seg-face">Offen</span></label>
						<label><input type="radio" name="sf" id="sf-beglichen"/><span class="seg-face">Beglichen</span></label>
					</div>
				</div>
				<div class="s-list">
					if len(vm.Rows) == 0 {
						@partials.Empty("🎉", "Keine Strafen. Brave Truppe.")
					} else {
						<div class="rows">
							for _, r := range vm.Rows {
								@row(r, vm.ReadOnly)
							}
						</div>
						<div class="s-empty-filter empty">
							<span class="empty-ico" aria-hidden="true">🎉</span>
							<p>Nichts in diesem Filter.</p>
						</div>
					}
				</div>
			</div>
			if !vm.ReadOnly {
				@noShowForm(vm)
			}
		</section>
	</div>
}

templ noShowForm(vm PageVM) {
	<form class="card" hx-post="/strafen" hx-target="#strafen-region" hx-swap="outerHTML">
		<div class="card-title">No-Show eintragen</div>
		<div class="card-sub" style="margin-bottom:14px">Nicht abgemeldet und nicht gekommen.</div>
		<div class="stack-sm" style="gap:10px">
			<label class="field">
				<span class="field-label">Mitglied</span>
				<select class="select" name="userId" required>
					<option value="" disabled selected>Mitglied wählen…</option>
					for _, u := range vm.Users {
						<option value={ u.ID }>{ u.Name }</option>
					}
				</select>
			</label>
			<label class="field">
				<span class="field-label">Donnerstag</span>
				<select class="select" name="datum" required>
					for i, d := range vm.Thursdays {
						<option value={ d.Value } selected?={ i == 0 }>{ d.Label }</option>
					}
				</select>
			</label>
			<label class="field">
				<span class="field-label">Betrag €</span>
				<input class="input" type="number" name="betrag" min="1" value={ strconv.Itoa(vm.NoShowDefault) }/>
			</label>
			<button type="submit" class="btn btn-primary">Strafe anlegen</button>
		</div>
	</form>
}

templ row(r Row, readOnly bool) {
	<div class={ "s-row", "is-" + string(r.Status) }>
		<span class="emo-box is-36" aria-hidden="true">{ r.Emoji }</span>
		<span style="min-width:0">
			<span class="s-head">
				<span class="s-name">{ r.UserName }</span>
				<span class="s-amount">{ strconv.Itoa(r.Betrag) } €</span>
				if r.Art == penalty.ArtNoShow {
					<span class="pill pill-caps is-amber">No-Show</span>
				} else {
					<span class="pill pill-caps is-red">Fehltage</span>
				}
				if r.Status == penalty.StatusBeglichen {
					<span class="pill pill-caps is-green">beglichen</span>
				}
				if r.Sichtbar {
					<span class="pill pill-caps is-blue">im Report</span>
				}
			</span>
			<span class="s-desc">{ beschreibung(r) }</span>
		</span>
		if !readOnly {
			<span class="s-actions">
				if r.Status == penalty.StatusOffen {
					<button
						type="button"
						class="btn btn-success btn-sm"
						hx-post={ fmt.Sprintf("/strafen/%d/begleichen", r.ID) }
						hx-target="#strafen-region"
						hx-swap="outerHTML"
					>Beglichen</button>
				}
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					title="Löschen (für Testeinträge)"
					aria-label="Strafe löschen"
					hx-delete={ fmt.Sprintf("/strafen/%d", r.ID) }
					hx-target="#strafen-region"
					hx-swap="outerHTML"
					hx-confirm="Strafe wirklich löschen? Normalerweise werden Strafen nur beglichen – Löschen ist für Testeinträge gedacht und startet den Fehltage-Zähler neu."
				>✕</button>
			</span>
		}
	</div>
}

func beschreibung(r Row) string {
	var s string
	switch r.Art {
	case penalty.ArtNoShow:
		s = fmt.Sprintf("Nicht abgemeldet am %s", timeutil.FormatDEShort(r.Datum))
	default:
		s = fmt.Sprintf("%d Fehltage in Folge seit %s", r.Tage, timeutil.FormatDEShort(r.Datum))
	}
	if r.Status == penalty.StatusBeglichen && r.BeglichenAm != nil {
		s += fmt.Sprintf(" · beglichen am %s", timeutil.FormatDEShort(*r.BeglichenAm))
		if r.SichtbarBis != nil {
			s += fmt.Sprintf(" (im Report bis %s)", timeutil.FormatDEShort(*r.SichtbarBis))
		}
	}
	return s
}
