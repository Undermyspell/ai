package days

import (
	"strconv"

	"github.com/michael/zumba-admin-ui/web/templates/partials"
)

// SheetVM ist ein Donnerstag zum Bearbeiten – im Bottom-Sheet oder als
// eigene Seite (Direktaufruf /days/{date}).
type SheetVM struct {
	ISO      string
	Long     string // "Donnerstag, 2. Oktober 2026"
	KW       int
	Excluded bool
	Present  int
	Absent   int
	Cells    []Person
	PrevISO  string
	NextISO  string
	Strip    []Chip
	// ReadOnly: der Tag liegt in einem abgeschlossenen (oder gar keinem)
	// Stammtischjahr – Anzeige ja, Änderungen nein.
	ReadOnly bool
}

type Person struct {
	UserID  string
	Name    string
	Emoji   string
	Absent  bool
	Message string
}

type Chip struct {
	ISO    string
	Label  string
	Active bool
}

// Sheet ist das Bottom-Sheet samt Overlay. Die Animation hängt am Rahmen,
// getauscht wird beim Blättern und nach jedem Umschalten nur #sheet-body.
templ Sheet(vm SheetVM) {
	<div class="sheet-overlay" data-sheet-close></div>
	<div class="sheet" role="dialog" aria-modal="true" aria-label="Donnerstag bearbeiten" tabindex="-1">
		@SheetBody(vm, true)
	</div>
}

// SheetBody lädt sich bei „absenceChanged" selbst neu – egal, ob die Änderung
// im Sheet oder darunter auf der Seite passiert ist.
templ SheetBody(vm SheetVM, inSheet bool) {
	<div
		id="sheet-body"
		if inSheet {
			hx-get={ "/days/" + vm.ISO + "?sheet=1" }
			hx-trigger="absenceChanged from:body"
			hx-select="#sheet-body"
			hx-target="this"
			hx-swap="outerHTML"
			hx-disinherit="*"
		}
	>
		<div class="sheet-head">
			@stepButton(vm.PrevISO, "‹", "Vorheriger Donnerstag", inSheet)
			<div class="sheet-title">
				<div class="sheet-date">{ vm.Long }</div>
				<div class="sheet-meta">
					if vm.Excluded {
						Sperrtag · KW { strconv.Itoa(vm.KW) }
					} else {
						<strong class="t-green">{ strconv.Itoa(vm.Present) }</strong> da ·
						<strong class="t-red">{ strconv.Itoa(vm.Absent) }</strong> abgemeldet ·
						KW { strconv.Itoa(vm.KW) }
					}
				</div>
			</div>
			@stepButton(vm.NextISO, "›", "Nächster Donnerstag", inSheet)
		</div>
		if len(vm.Strip) > 0 {
			<div class="sheet-strip">
				for _, c := range vm.Strip {
					if inSheet {
						<button
							type="button"
							class={ templ.KV("is-active", c.Active) }
							hx-get={ "/days/" + c.ISO + "?sheet=1" }
							hx-select="#sheet-body"
							hx-target="#sheet-body"
							hx-swap="outerHTML"
						>{ c.Label }</button>
					} else {
						<a href={ templ.URL("/days/" + c.ISO) } class={ templ.KV("is-active", c.Active) }>{ c.Label }</a>
					}
				}
			</div>
		}
		if vm.Excluded {
			<p class="sheet-note">Dieser Donnerstag ist gesperrt und zählt nicht in die Auswertung.</p>
		} else {
			if vm.ReadOnly {
				<p class="sheet-note" style="padding-top:0">Abgeschlossenes Stammtischjahr – nur Ansicht.</p>
			}
			<div class="sheet-grid">
				for _, c := range vm.Cells {
					<button
						type="button"
						class={ "person", templ.KV("is-absent", c.Absent) }
						title={ personTitle(c, vm.ReadOnly) }
						{ partials.Toggle(c.UserID, vm.ISO, vm.ReadOnly)... }
					>
						<span class="emo-box is-34" aria-hidden="true">{ c.Emoji }</span>
						<span class="person-text">
							<span class="person-name">{ c.Name }</span>
							<span class="person-status">{ status(c) }</span>
						</span>
					</button>
				}
			</div>
		}
		if inSheet {
			<div class="sheet-foot">
				<button type="button" class="btn btn-primary" data-sheet-close>Fertig</button>
			</div>
		}
	</div>
}

templ stepButton(iso, glyph, label string, inSheet bool) {
	if iso == "" {
		<button type="button" class="btn btn-nav" disabled aria-label={ label }>{ glyph }</button>
	} else if inSheet {
		<button
			type="button"
			class="btn btn-nav"
			aria-label={ label }
			title={ label }
			hx-get={ "/days/" + iso + "?sheet=1" }
			hx-select="#sheet-body"
			hx-target="#sheet-body"
			hx-swap="outerHTML"
		>{ glyph }</button>
	} else {
		<a class="btn btn-nav" href={ templ.URL("/days/" + iso) } aria-label={ label } title={ label }>{ glyph }</a>
	}
}

// Detail ist der Direktaufruf als eigene Seite.
templ Detail(vm SheetVM) {
	<a class="back-link" href="/days">← Alle Donnerstage</a>
	<section class="card card-flush" style="max-width:720px">
		@SheetBody(vm, false)
	</section>
}

func status(c Person) string {
	if !c.Absent {
		return "anwesend"
	}
	if c.Message != "" {
		return "„" + c.Message + "“"
	}
	return "abgemeldet"
}

func personTitle(c Person, readOnly bool) string {
	t := c.Name + " – " + status(c)
	if !readOnly {
		if c.Absent {
			t += " · Klick = anwesend"
		} else {
			t += " · Klick = abgemeldet"
		}
	}
	return t
}
